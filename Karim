function saveBlsSettings() {
    state.settings.bls = {
        email: document.getElementById('setBlsEmail').value.trim(),
        password: document.getElementById('setBlsPassword').value
    };
    saveState();
    alert('✅ تم الحفظ');
}

// ===== EXPORT/IMPORT =====
function exportData() {
    const data = {
        version: '2.1',
        exportedAt: new Date().toISOString(),
        clients: state.clients,
        bookings: state.bookings,
        proxies: state.proxies,
        logs: state.logs,
        settings: state.settings,
        stats: state.stats
    };
    const json = JSON.stringify(data, null, 2);
    downloadFile(json, `bls_mantisx_backup_${new Date().toISOString().slice(0,10)}.json`, 'application/json');
    log('SUCCESS', '📦 نسخة احتياطية');
}

function importData() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
            try {
                const data = JSON.parse(ev.target.result);
                if (!data.clients) { alert('⚠️ ملف غير صالح'); return; }
                if (!confirm(`استيراد:\n• ${data.clients.length} زبون\n• ${(data.bookings||[]).length} حجز\n• ${(data.proxies||[]).length} بروكسي\n\nمتابعة؟`)) return;
                
                state.clients = data.clients || [];
                state.bookings = data.bookings || [];
                state.proxies = data.proxies || [];
                state.settings = data.settings || state.settings;
                state.stats = data.stats || { captchas: 0 };
                
                saveState();
                updateStats();
                renderClients();
                renderBookings();
                renderProxies();
                loadSettingsToForm();
                alert('✅ تم الاستيراد');
            } catch (err) { alert('❌ خطأ: ' + err.message); }
        };
        reader.readAsText(file);
    };
    input.click();
}

function clearAllData() {
    if (!confirm('⚠️ حذف كل البيانات؟')) return;
    if (!confirm('تأكيد أخير؟')) return;
    localStorage.removeItem('bls_mantisx_v2');
    location.reload();
}

// ===== HELPERS =====
function downloadFile(content, filename, type) {
    const blob = new Blob([content], { type: type + ';charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

function getDayName(day) {
    const map = { monday:'الإثنين', tuesday:'الثلاثاء', wednesday:'الأربعاء', thursday:'الخميس', friday:'الجمعة', saturday:'السبت', sunday:'الأحد' };
    return map[day] || day;
}

function loadSettingsToForm() {
    const s = state.settings;
    if (s.agency) {
        document.getElementById('setAgencyName').value = s.agency.name || '';
        document.getElementById('setAgencyPhone').value = s.agency.phone || '';
        document.getElementById('setAgencyEmail').value = s.agency.email || '';
        document.getElementById('setAgencyLicense').value = s.agency.license || '';
    }
    if (s.telegram) {
        document.getElementById('setTgToken').value = s.telegram.token || '';
        document.getElementById('setTgChatId').value = s.telegram.chatId || '';
    }
    if (s.bls) {
        document.getElementById('setBlsEmail').value = s.bls.email || '';
        document.getElementById('setBlsPassword').value = s.bls.password || '';
    }
    if (state.captchaApiKey) {
        document.getElementById('captchaApiKey').value = state.captchaApiKey;
    }
}

// ===== SAVE/LOAD =====
function saveState() {
    const data = {
        clients: state.clients,
        bookings: state.bookings,
        proxies: state.proxies,
        logs: state.logs,
        settings: state.settings,
        stats: state.stats,
        captchaMethod: state.captchaMethod,
        captchaApiKey: state.captchaApiKey
    };
    try {
        localStorage.setItem('bls_mantisx_v2', JSON.stringify(data));
    } catch (e) {
        if (e.name === 'QuotaExceededError') {
            alert('⚠️ الذاكرة ممتلئة! احذف بعض الصور');
        }
    }
}

function loadState() {
    const saved = localStorage.getItem('bls_mantisx_v2');
    if (!saved) return;
    try {
        const data = JSON.parse(saved);
        state.clients = data.clients || [];
        state.bookings = data.bookings || [];
        state.proxies = data.proxies || [];
        state.logs = data.logs || [];
        state.settings = data.settings || state.settings;
        state.stats = data.stats || { captchas: 0 };
        state.captchaMethod = data.captchaMethod || 'manual';
        state.captchaApiKey = data.captchaApiKey || '';
    } catch (e) { console.error('Load error:', e); }
}

// ===== CLOCK =====
function updateClock() {
    const now = new Date();
    const date = now.toLocaleDateString('ar-EG', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
    const time = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    document.getElementById('headerDate').textContent = date;
    document.getElementById('headerTime').textContent = time;
}

// ===== INIT =====
document.addEventListener('DOMContentLoaded', () => {
    loadState();
    updateStats();
    renderClients();
    renderBookings();
    renderProxies();
    renderLogs();
    loadSettingsToForm();
    updateClock();
    setInterval(updateClock, 30000);
    
    log('SYSTEM', '🚀 BLS MANTISX Agency Portal v2.1');
    log('INFO', `📊 ${state.clients.length} زبون، ${state.bookings.length} حجز، ${state.proxies.length} بروكسي`);
    
    const methodBtn = document.querySelector(`.method-btn[data-method="${state.captchaMethod}"]`);
    if (methodBtn) setCaptchaMethod(state.captchaMethod, methodBtn);
});

// ===== KEYBOARD =====
document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.id === 'captchaInput') submitCaptcha();
    if (e.key === 'Escape') {
        closeProxyModal();
        document.getElementById('captchaInput').value = '';
