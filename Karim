}

function saveTelegramSettings() {
    state.settings.telegram = {
        token: document.getElementById('setTgToken').value.trim(),
        chatId: document.getElementById('setTgChatId').value.trim()
    };
    saveState();
    alert('✅ تم الحفظ');
}

function testTelegram() {
    const { token, chatId } = state.settings.telegram;
    if (!token || !chatId) { alert('⚠️ أدخل Token و Chat ID'); return; }
    
    fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
