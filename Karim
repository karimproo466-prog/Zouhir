<script>
// ==========================================
// BLS MANTISX - Agency Portal v2.1
// With Photos in Register + Proxy Manager
// ==========================================

// ===== State =====
const state = {
    clients: [],
    bookings: [],
    logs: [],
    proxies: [],
    stats: { captchas: 0 },
    settings: {
        agency: { name: '', phone: '', email: '', license: '' },
        telegram: { token: '', chatId: '' },
        bls: { email: '', password: '' },
        proxy: {
            rotationStrategy: 'rotating',
            maxRetries: 3,
            healthCheck: 15,
            autoRetry: true
        }
    },
    tempRegPhotos: { photo: null, passportPhoto: null },
    currentPhotoClient: null,
    captchaMethod: 'manual',
    captchaApiKey: '',
    filters: { clients: '' }
};

const CENTERS = {
    'Spain': ['الرباط', 'الدار البيضاء', 'مراكش', 'طنجة', 'أكادير', 'فاس'],
    'France': ['الرباط', 'الدار البيضاء', 'مراكش'],
    'Italy': ['الرباط', 'الدار البيضاء'],
    'Germany': ['الرباط', 'الدار البيضاء'],
    'Portugal': ['الرباط', 'الدار البيضاء'],
    'Netherlands': ['الرباط', 'الدار البيضاء'],
    'Belgium': ['الرباط', 'الدار البيضاء'],
    'Switzerland': ['الرباط', 'الدار البيضاء']
};

const COUNTRY_NAMES = {
    'Spain': 'إسبانيا', 'France': 'فرنسا', 'Italy': 'إيطاليا', 
    'Germany': 'ألمانيا', 'Portugal': 'البرتغال', 'Netherlands': 'هولندا',
    'Belgium': 'بلجيكا', 'Switzerland': 'سويسرا'
};

const VISA_NAMES = {
    'Tourism': 'سياحة', 'Business': 'عمل', 'Student': 'دراسة',
    'Family': 'زيارة عائلية', 'Medical': 'علاج', 'Transit': 'ترانزيت'
};

// ===== Logging =====
function log(level, message) {
    const now = new Date();
    const time = now.toLocaleTimeString('en-GB');
    state.logs.push({ time, level, message, timestamp: now.toISOString() });
    if (state.logs.length > 500) state.logs.shift();
    renderLogs();
    saveState();
}

function renderLogs() {
    const console = document.getElementById('logConsole');
    if (!console) return;
    if (state.logs.length === 0) {
        console.innerHTML = `<div class="log-line INFO"><span class="time">[--:--:--]</span><span class="level">[INFO]</span><span class="msg">System initialized</span></div>`;
        return;
    }
    const html = state.logs.slice(-100).map(l => `
        <div class="log-line ${l.level}">
            <span class="time">[${l.time}]</span>
            <span class="level">[${l.level}]</span>
            <span class="msg">${l.message}</span>
        </div>
    `).join('');
    console.innerHTML = html;
    console.scrollTop = console.scrollHeight;
}

function clearLogs() {
    if (!confirm('مسح جميع السجلات؟')) return;
    state.logs = [];
    saveState();
    renderLogs();
    log('INFO', 'تم مسح السجلات');
}

function exportLogs() {
    const text = state.logs.map(l => `[${l.time}] [${l.level}] ${l.message}`).join('\n');
    downloadFile(text, 'logs.txt', 'text/plain');
}

// ===== Navigation =====
function showPage(pageId, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const page = document.getElementById('page-' + pageId);
    if (page) page.classList.add('active');
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    
    if (pageId === 'photos') populatePhotoSelect();
    if (pageId === 'proxies') renderProxies();
    if (pageId === 'dashboard') updateStats();
    if (pageId === 'clients') renderClients();
    if (pageId === 'bookings') renderBookings();
    if (pageId === 'logs') renderLogs();
    
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== Statistics =====
function updateStats() {
    const complete = state.clients.filter(c => c.photo && c.passportPhoto).length;
    const working = state.proxies.filter(p => p.status === 'working').length;
    
    document.getElementById('statClients').textContent = state.clients.length;
    document.getElementById('statComplete').textContent = complete;
    document.getElementById('statProxies').textContent = working;
    document.getElementById('statBookings').textContent = state.bookings.length;
    
    document.getElementById('clientsCount').textContent = state.clients.length;
    document.getElementById('bookingsCount').textContent = state.bookings.length;
    document.getElementById('clientsListCount').textContent = state.clients.length;
    document.getElementById('proxiesCount').textContent = state.proxies.length;
}

// ===== Register Photos (NEW) =====
function handleRegPhoto(event, type) {
    const file = event.target.files[0];
    if (!file) return;
    
    if (!file.type.startsWith('image/')) {
        alert('⚠️ الرجاء اختيار صورة');
        return;
    }
    
    if (file.size > 5 * 1024 * 1024) {
        alert('⚠️ الحجم كبير جداً (الحد 5MB)');
        return;
    }
    
    const reader = new FileReader();
    reader.onload = (e) => {
        const base64 = e.target.result;
        
        if (type === 'photo') {
            state.tempRegPhotos.photo = base64;
            updateRegPhotoZone('regPhotoZone', base64, 'الصورة الشخصية');
        } else {
            state.tempRegPhotos.passportPhoto = base64;
            updateRegPhotoZone('regPassportZone', base64, 'صورة الجواز');
        }
        
        log('SUCCESS', `📸 تم تحميل صورة (${type === 'photo' ? 'شخصية' : 'جواز'})`);
    };
    reader.readAsDataURL(file);
}

function updateRegPhotoZone(zoneId, base64, label) {
    const zone = document.getElementById(zoneId);
    if (!zone) return;
    zone.classList.add('has-file');
    
    const isPhoto = zoneId === 'regPhotoZone';
    const inputId = isPhoto ? 'regPhotoFile' : 'regPassportFile';
    const type = isPhoto ? 'photo' : 'passport';
    const icon = isPhoto ? 'bi-person-square' : 'bi-card-text';
    
    zone.innerHTML = `
        <input type="file" id="${inputId}" accept="image/*" onchange="handleRegPhoto(event, '${type}')">
        <div class="check-badge"><i class="bi bi-check-lg"></i></div>
        <button class="remove-btn" onclick="event.stopPropagation(); removeRegPhoto('${type}')" title="حذف">
            <i class="bi bi-x-lg"></i>
        </button>
        <img src="${base64}" class="preview" alt="${label}">
        <div class="title" style="margin-top:0.5rem;">✅ ${label} جاهزة</div>
        <div class="hint">اضغط لتغييرها</div>
    `;
}

function removeRegPhoto(type) {
    if (type === 'photo') {
        state.tempRegPhotos.photo = null;
        resetRegPhotoZone('regPhotoZone', 'regPhotoFile', 'photo', 'الصورة الشخصية', 'bi-person-square', 'JPG أو PNG - خلفية بيضاء');
    } else {
        state.tempRegPhotos.passportPhoto = null;
        resetRegPhotoZone('regPassportZone', 'regPassportFile', 'passport', 'صورة جواز السفر', 'bi-card-text', 'صفحة البيانات بوضوح');
    }
    log('INFO', `🗑️ تم حذف صورة (${type === 'photo' ? 'شخصية' : 'جواز'})`);
