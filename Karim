function importProxies() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.txt,.json';
    
    input.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = (ev) => {
            const text = ev.target.result;
            let imported = 0;
            
            try {
                // Try JSON first
                if (text.trim().startsWith('[') || text.trim().startsWith('{')) {
                    const data = JSON.parse(text);
                    const list = Array.isArray(data) ? data : (data.proxies || []);
                    list.forEach(p => {
                        if (p.host && p.port) {
                            if (!state.proxies.find(x => x.host === p.host && x.port === p.port)) {
                                state.proxies.push({
                                    id: 'p_' + Date.now() + Math.random(),
                                    host: p.host,
                                    port: parseInt(p.port),
                                    type: p.type || 'HTTP',
                                    country: p.country || '',
                                    label: p.label || '',
                                    username: p.username || '',
                                    password: p.password || '',
                                    status: 'untested',
                                    lastTest: null,
                                    responseTime: null,
                                    createdAt: new Date().toISOString(),
                                    failCount: 0,
                                    successCount: 0
                                });
                                imported++;
                            }
                        }
                    });
                } else {
                    // Parse TXT lines
                    text.split('\n').forEach(line => {
                        line = line.trim();
                        if (!line || line.startsWith('#')) return;
                        
                        // Parse: type://user:pass@host:port OR host:port
                        let type = 'HTTP';
                        let username = '';
                        let password = '';
                        let host = '';
                        let port = '';
                        
                        if (line.includes('://')) {
                            const [t, rest] = line.split('://');
                            type = t.toUpperCase();
                            line = rest;
                        }
                        
                        if (line.includes('@')) {
                            const [creds, hp] = line.split('@');
                            [username, password] = creds.split(':');
                            [host, port] = hp.split(':');
                        } else {
                            [host, port] = line.split(':');
                        }
                        
                        if (host && port) {
                            if (!state.proxies.find(x => x.host === host && x.port === parseInt(port))) {
                                state.proxies.push({
                                    id: 'p_' + Date.now() + Math.random(),
                                    host,
                                    port: parseInt(port),
                                    type,
                                    country: '',
                                    label: '',
                                    username,
                                    password,
                                    status: 'untested',
                                    lastTest: null,
                                    responseTime: null,
                                    createdAt: new Date().toISOString(),
                                    failCount: 0,
                                    successCount: 0
                                });
                                imported++;
                            }
                        }
                    });
                }
                
                saveState();
                renderProxies();
                updateStats();
                log('SUCCESS', `📥 تم استيراد ${imported} بروكسي`);
                alert(`✅ تم استيراد ${imported} بروكسي`);
            } catch (err) {
                alert('❌ خطأ في قراءة الملف: ' + err.message);
            }
        };
        reader.readAsText(file);
    };
    input.click();
}

function clearAllProxies() {
    if (state.proxies.length === 0) {
        alert('لا توجد بروكسيات');
        return;
    }
    if (!confirm(`⚠️ حذف جميع البروكسيات (${state.proxies.length})؟`)) return;
    state.proxies = [];
    saveState();
    renderProxies();
    updateStats();
    log('WARNING', '🗑️ تم حذف جميع البروكسيات');
}

// ===== CAPTCHA =====
function setCaptchaMethod(method, btn) {
    state.captchaMethod = method;
    document.querySelectorAll('.method-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    
    const labels = { manual: 'يدوي', '2captcha': '2Captcha API', tesseract: 'Tesseract OCR' };
    const hints = {
        manual: 'الطريقة اليدوية هي الأكثر أماناً — موظفك يقرأ الرمز ويدخله',
        '2captcha': 'حل تلقائي عبر خدمة مدفوعة — يتطلب مفتاح API',
        tesseract: 'حل مجاني عبر OCR — الدقة 40-60% فقط'
    };
    
    document.getElementById('currentMethodLabel').textContent = labels[method];
    document.getElementById('methodHint').textContent = hints[method];
    saveState();
}

function resetCaptcha() {
    document.getElementById('captchaDisplay').innerHTML = `
        <div class="no-captcha">
            <i class="bi bi-shield-slash-fill"></i>
            <p><strong>لا توجد كابتشا حالياً</strong></p>
            <p style="font-size:0.85rem;">ارفع صورة الكابتشا لبدء المعالجة</p>
            <label style="display:inline-block; margin-top:1rem; padding:0.75rem 1.5rem; background:var(--primary); color:white; border-radius:10px; cursor:pointer; font-weight:700;">
                <i class="bi bi-upload"></i> رفع صورة الكابتشا
                <input type="file" accept="image/*" style="display:none;" onchange="loadCaptchaImage(event)">
            </label>
        </div>
    `;
    document.getElementById('captchaInput').value = '';
}

function loadCaptchaImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        document.getElementById('captchaDisplay').innerHTML = `
            <img src="${e.target.result}" alt="Captcha">
            <p style="margin-top:1rem; color:var(--text-sec); font-size:0.85rem;">
                👇 اكتب الرمز الذي تراه
            </p>
        `;
        document.getElementById('captchaInput').focus();
        log('INFO', '📸 تم تحميل صورة الكابتشا');
    };
    reader.readAsDataURL(file);
}

function submitCaptcha() {
    const code = document.getElementById('captchaInput').value.trim().toUpperCase();
    if (!code) { alert('⚠️ أدخل رمز الكابتشا'); return; }
    if (code.length < 4) { alert('⚠️ الرمز قصير'); return; }
    
    state.stats.captchas++;
    saveState();
    updateStats();
    log('SUCCESS', `✅ تم حل الكابتشا: ${code}`);
    
    navigator.clipboard.writeText(code).then(() => {
        alert(`✅ تم حل الكابتشا: ${code}\n\n📋 تم نسخها - الصقها في المتصفح`);
    }).catch(() => {
        alert(`✅ تم حل الكابتشا: ${code}`);
    });
    
    document.getElementById('captchaInput').value = '';
}

function saveCaptchaKey() {
    const key = document.getElementById('captchaApiKey').value.trim();
    if (!key) { alert('⚠️ أدخل المفتاح'); return; }
    state.captchaApiKey = key;
    saveState();
    log('SUCCESS', '🔑 تم حفظ مفتاح 2Captcha');
    alert('✅ تم حفظ المفتاح');
}

// ===== BOOKINGS =====
function renderBookings() {
    const tbody = document.getElementById('bookingsTableBody');
    if (!tbody) return;
    if (state.bookings.length === 0) {
        tbody.innerHTML = `
            <tr><td colspan="8">
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>لا توجد حجوزات بعد</p>
                    <p class="hint">ستظهر هنا بعد تنفيذها من البوت</p>
                </div>
            </td></tr>
        `;
        return;
    }
    tbody.innerHTML = state.bookings.map((b, i) => `
        <tr>
            <td>${i + 1}</td>
            <td><code style="color:var(--primary); font-weight:700;">${b.reference}</code></td>
            <td>${b.clientName}</td>
            <td>${COUNTRY_NAMES[b.destination] || b.destination}</td>
            <td>${b.date}</td>
            <td>${b.time}</td>
            <td><span class="badge-blk badge-success-blk"><i class="bi bi-check-circle-fill"></i> محجوز</span></td>
            <td>
                <button class="btn-blk btn-outline-blk btn-sm-blk" onclick="printBooking('${b.id}')" title="طباعة">
                    <i class="bi bi-printer-fill"></i>
                </button>
                <button class="btn-blk btn-danger-blk btn-sm-blk" onclick="cancelBooking('${b.id}')" title="إلغاء">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </td>
        </tr>
    `).join('');
}

