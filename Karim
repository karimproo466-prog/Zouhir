function handlePhotoUpload(event, type) {
    const file = event.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { alert('⚠️ الرجاء اختيار صورة'); return; }
    if (file.size > 5 * 1024 * 1024) { alert('⚠️ الحجم كبير'); return; }
    
    const reader = new FileReader();
    reader.onload = (e) => {
        const base64 = e.target.result;
        if (type === 'photo') {
            state.currentPhotoClient.photo = base64;
        } else {
            state.currentPhotoClient.passportPhoto = base64;
        }
        saveState();
        renderPhotoZones(state.currentPhotoClient);
        updateStats();
        renderClients(state.filters.clients);
        log('SUCCESS', `📸 تم رفع صورة: ${state.currentPhotoClient.name}`);
    };
    reader.readAsDataURL(file);
}

