function saveProxy() {
    const host = document.getElementById('proxyHost').value.trim();
    const port = document.getElementById('proxyPort').value.trim();
    const type = document.getElementById('proxyType').value;
    
    if (!host) { alert('⚠️ أدخل عنوان البروكسي'); return; }
    if (!port) { alert('⚠️ أدخل المنفذ'); return; }
    if (parseInt(port) < 1 || parseInt(port) > 65535) {
        alert('⚠️ المنفذ غير صحيح (1-65535)');
        return;
    }
    
    const proxy = {
        id: 'p_' + Date.now(),
        host,
        port: parseInt(port),
        type,
        country: document.getElementById('proxyCountry').value.trim().toUpperCase(),
        label: document.getElementById('proxyLabel').value.trim(),
        username: document.getElementById('proxyUser').value.trim(),
        password: document.getElementById('proxyPass').value,
        status: 'untested',
        lastTest: null,
        responseTime: null,
        createdAt: new Date().toISOString(),
        failCount: 0,
        successCount: 0
    };
    
    // Check duplicate
    if (state.proxies.find(p => p.host === host && p.port === proxy.port)) {
        alert('⚠️ هذا البروكسي موجود مسبقاً!');
        return;
    }
    
    state.proxies.push(proxy);
    saveState();
    renderProxies();
    updateStats();
    closeProxyModal();
    
    log('SUCCESS', `🛡️ تم إضافة بروكسي: ${host}:${port}`);
    alert(`✅ تم إضافة البروكسي\n\n${host}:${port}\n${type}`);
}

function deleteProxy(id) {
    const p = state.proxies.find(x => x.id === id);
    if (!p) return;
    if (!confirm(`حذف البروكسي ${p.host}:${p.port}؟`)) return;
    state.proxies = state.proxies.filter(x => x.id !== id);
    saveState();
    renderProxies();
    updateStats();
    log('WARNING', `🗑️ تم حذف بروكسي: ${p.host}:${p.port}`);
}

function testProxy(id) {
    const p = state.proxies.find(x => x.id === id);
    if (!p) return;
    
    p.status = 'testing';
    renderProxies();
    log('INFO', `🔍 اختبار: ${p.host}:${p.port}...`);
    
    // Simulated test
    setTimeout(() => {
        const success = Math.random() > 0.3;
        if (success) {
            p.status = 'working';
            p.responseTime = Math.floor(Math.random() * 500) + 50;
            p.successCount++;
            log('SUCCESS', `✅ ${p.host}:${p.port} يعمل (${p.responseTime}ms)`);
        } else {
            p.status = 'failed';
            p.responseTime = null;
            p.failCount++;
            log('ERROR', `❌ ${p.host}:${p.port} فاشل`);
        }
        p.lastTest = new Date().toISOString();
        saveState();
        renderProxies();
        updateStats();
    }, 1500);
}

function testAllProxies() {
    if (state.proxies.length === 0) {
        alert('⚠️ لا توجد بروكسيات لاختبارها');
        return;
    }
    log('INFO', `🔍 اختبار جميع البروكسيات (${state.proxies.length})...`);
    state.proxies.forEach(p => p.status = 'testing');
    renderProxies();
    
    let tested = 0;
    state.proxies.forEach((p, index) => {
        setTimeout(() => {
            const success = Math.random() > 0.3;
            if (success) {
                p.status = 'working';
                p.responseTime = Math.floor(Math.random() * 500) + 50;
                p.successCount++;
            } else {
                p.status = 'failed';
                p.responseTime = null;
                p.failCount++;
            }
            p.lastTest = new Date().toISOString();
            tested++;
            
            if (tested === state.proxies.length) {
                const working = state.proxies.filter(x => x.status === 'working').length;
                log('SUCCESS', `✅ اكتمل الاختبار: ${working}/${state.proxies.length} يعمل`);
                saveState();
                updateStats();
            }
            renderProxies();
        }, 500 + index * 300);
    });
}

