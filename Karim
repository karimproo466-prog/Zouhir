    const b = state.bookings.find(x => x.id === id);
    if (!b) return;
    const win = window.open('', '_blank');
    win.document.write(`
        <html dir="rtl"><head><title>إيصال - ${b.reference}</title>
        <style>
            body { font-family: 'Tajawal', Arial; padding: 2.5rem; max-width: 700px; margin: auto; }
            h1 { color: #1e40af; border-bottom: 3px solid #1e40af; padding-bottom: 1rem; }
            .row { display: flex; justify-content: space-between; padding: 0.9rem 0; border-bottom: 1px solid #eee; }
            .label { color: #666; }
            .value { font-weight: 700; }
            .footer { margin-top: 3rem; text-align: center; color: #888; }
        </style></head><body>
        <h1>✅ إيصال حجز</h1>
        <div class="row"><span class="label">المرجع:</span><span class="value">${b.reference}</span></div>
        <div class="row"><span class="label">الزبون:</span><span class="value">${b.clientName}</span></div>
        <div class="row"><span class="label">الوجهة:</span><span class="value">${COUNTRY_NAMES[b.destination]}</span></div>
        <div class="row"><span class="label">التاريخ:</span><span class="value">${b.date}</span></div>
        <div class="row"><span class="label">الوقت:</span><span class="value">${b.time}</span></div>
        <div class="footer">BLS MANTISX - ${new Date().toLocaleString('ar-EG')}</div>
        </body></html>
    `);
    win.document.close();
    setTimeout(() => win.print(), 600);
}

function cancelBooking(id) {
    const b = state.bookings.find(x => x.id === id);
    if (!b) return;
    if (!confirm(`إلغاء حجز ${b.reference}؟`)) return;
    b.status = 'cancelled';
    saveState();
    renderBookings();
    log('WARNING', `🚫 تم إلغاء: ${b.reference}`);
}

function exportBookings() {
    if (state.bookings.length === 0) { alert('لا توجد حجوزات'); return; }
    const data = JSON.stringify(state.bookings, null, 2);
    downloadFile(data, 'bookings.json', 'application/json');
}

// ===== SETTINGS =====
function saveAgencySettings() {
    state.settings.agency = {
        name: document.getElementById('setAgencyName').value.trim(),
        phone: document.getElementById('setAgencyPhone').value.trim(),
        email: document.getElementById('setAgencyEmail').value.trim(),
        license: document.getElementById('setAgencyLicense').value.trim()
    };
