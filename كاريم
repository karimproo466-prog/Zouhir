    <!-- Toast container -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        /* ============================================= */
        /* حالة التطبيق */
        /* ============================================= */
        const state = {
            running: false,
            provider: null,
            retries: 0,
            startTime: null,
            uptimeTimer: null,
            logs: [],
            proxies: [],
            accounts: [],
            appointments: [],
            stats: { appointments: 0, success: 0, failed: 0, pending: 0 }
        };

        /* ============================================= */
        /* أدوات مساعدة */
        /* ============================================= */
        const $ = id => document.getElementById(id);

        function now() {
            return new Date().toLocaleTimeString('en-GB');
        }

        function toast(msg, type = 'info') {
            const bg = { info: 'primary', success: 'success', error: 'danger', warning: 'warning' }[type] || 'primary';
            const el = document.createElement('div');
            el.className = 'toast align-items-center border-0 show mb-2';
            el.innerHTML = `<div class="d-flex"><div class="toast-body text-white">` +
                `<i class="bi bi-info-circle ms-2"></i>${msg}</div>` +
                `<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>`;
            el.querySelector('.toast').style.background = `var(--bs-${bg})`;
            document.querySelector('.toast-container').appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }

        /* ============================================= */
        /* القائمة الجانبية */
        /* ============================================= */
        function toggleSidebar() {
            $('sidebar').classList.toggle('open');
            $('sidebarOverlay').classList.toggle('show');
        }

        document.querySelectorAll('.sidebar .nav-item').forEach(item => {
            item.addEventListener('click', () => {
                document.querySelectorAll('.sidebar .nav-item').forEach(n => n.classList.remove('active'));
                item.classList.add('active');
                const tab = item.dataset.tab;
                document.querySelectorAll('.tab-page').forEach(p => p.classList.remove('active'));
                $('tab-' + tab).classList.add('active');
                if (window.innerWidth <= 992) toggleSidebar();
            });
        });

        /* ============================================= */
        /* السجلات */
        /* ============================================= */
        const LOG_CLASSES = {
            info: 'log-info', success: 'log-success', error: 'log-error',
            warning: 'log-warning', telegram: 'log-telegram', palestine: 'log-palestine'
        };

        function addLog(msg, type = 'info') {
            const entry = { time: now(), msg, type };
            state.logs.push(entry);
            if (state.logs.length > 500) state.logs.shift();
            const line = document.createElement('div');
            line.className = 'log-entry ' + (LOG_CLASSES[type] || 'log-info');
            line.innerHTML = `<span class="log-time">[${entry.time}]</span> ${msg}`;
            $('liveLog').appendChild(line);
            $('liveLog').scrollTop = $('liveLog').scrollHeight;
            $('logCount').textContent = state.logs.length;
            if ($('tab-logs').classList.contains('active')) renderFullLogs();
        }

        function renderFullLogs() {
            const filter = $('logFilter').value;
            const box = $('fullLog');
            box.innerHTML = '';
            state.logs.filter(l => filter === 'all' || l.type === filter).forEach(l => {
                const d = document.createElement('div');
                d.className = 'log-entry ' + (LOG_CLASSES[l.type] || 'log-info');
                d.innerHTML = `<span class="log-time">[${l.time}]</span> ${l.msg}`;
                box.appendChild(d);
            });
            box.scrollTop = box.scrollHeight;
        }

        function clearLogs() {
            state.logs = [];
            $('liveLog').innerHTML = '';
            $('fullLog').innerHTML = '';
            $('logCount').textContent = 0;
            addLog('تم تفريغ السجل', 'warning');
        }

        function downloadLogs() {
            const text = state.logs.map(l => `[${l.time}] [${l.type.toUpperCase()}] ${l.msg}`).join('\n');
            const blob = new Blob([text], { type: 'text/plain' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'bot-logs.txt';
            a.click();
            URL.revokeObjectURL(a.href);
            toast('تم تصدير السجل', 'success');
        }

        /* ============================================= */
        /* المحرك */
        /* ============================================= */
        function startEngine() {
            if (!state.provider) {
                toast('حدّد مزوّد الخدمة أولاً من صفحة Providers', 'warning');
                addLog('فشل التشغيل: لا يوجد مزوّد محدد', 'error');
                return;
            }
            state.running = true;
            state.retries = 0;
            state.startTime = Date.now();
            $('btnStart').disabled = true;
            $('btnStop').disabled = false;
            $('engineStatus').className = 'engine-status running';
            $('engineStatusText').textContent = 'قيد التشغيل';
            $('engineProvider').textContent = state.provider;
            $('footerEngine').textContent = 'Running';
            addLog(`تم تشغيل المحرك — المزوّد: ${state.provider}`, 'success');
            toast('المحرك يعمل الآن', 'success');

            state.uptimeTimer = setInterval(updateUptime, 1000);

            // محاكاة دورة عمل (نموذج توضيحي)
            state.simTimer = setInterval(() => {
                if (!state.running) return;
                state.retries++;
                $('engineRetries').textContent = state.retries;
                const pct = Math.min(100, state.retries % 101);
                $('engineProgress').style.width = pct + '%';
                $('engineTask').textContent = `فحص توفر المواعيد... محاولة ${state.retries}`;
                const roll = Math.random();
                if (roll < 0.06) {
                    addLog('تم رصد موعد متاح!', 'success');
                    addAppointment();
                } else if (roll < 0.15) {
                    addLog('انتهت مهلة الطلب، إعادة المحاولة', 'error');
                    state.stats.failed++;
                } else if (roll < 0.25) {
                    addLog('لا توجد مواعيد متاحة حالياً', 'warning');
                    state.stats.pending++;
                } else {
                    addLog(`استعلام #${state.retries} — لا تغيير`, 'info');
                    state.stats.success++;
                }
                updateStats();
            }, 3000);
        }

        function stopEngine() {
            state.running = false;
            clearInterval(state.simTimer);
            clearInterval(state.uptimeTimer);
            $('btnStart').disabled = false;
            $('btnStop').disabled = true;
            $('engineStatus').className = 'engine-status stopped';
            $('engineStatusText').textContent = 'متوقف';
            $('footerEngine').textContent = 'Stopped';
            $('engineTask').textContent = 'لا توجد مهمة جارية';
            $('engineProgress').style.width = '0%';
            addLog('تم إيقاف المحرك', 'warning');
            toast('تم إيقاف المحرك', 'warning');
        }

        function updateUptime() {
            const s = Math.floor((Date.now() - state.startTime) / 1000);
            const h = String(Math.floor(s / 3600)).padStart(2, '0');
            const m = String(Math.floor(s % 3600 / 60)).padStart(2, '0');
            const sec = String(s % 60).padStart(2, '0');
            $('engineUptime').textContent = `${h}:${m}:${sec}`;
        }

        function updateStats() {
            $('statAppointments').textContent = state.stats.appointments;
            $('statSuccess').textContent = state.stats.success;
            $('statFailed').textContent = state.stats.failed;
            $('statPending').textContent = state.stats.pending;
        }

        /* ============================================= */
        /* المزوّدون */
        /* ============================================= */
        function selectProvider(name) {
            state.provider = name;
            document.querySelectorAll('#tab-providers .provider-card').forEach(c => {
                c.style.borderColor = '';
                c.classList.remove('border-animated');
            });
            event.target.closest('.provider-card').style.borderColor = 'var(--primary)';
            addLog(`تم تحديد المزوّد: ${name}`, 'info');
            toast(`المزوّد الحالي: ${name}`, 'info');
        }

        /* ============================================= */
        /* المواعيد */
        /* ============================================= */
        function addAppointment() {
            state.stats.appointments++;
            const cities = ['مدريد', 'طنجة', 'الرباط', 'الدار البيضاء', 'برشلونة'];
            const body = $('appointmentsBody');
            if (body.querySelector('.empty-state')) body.innerHTML = '';
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${state.stats.appointments}</td>
                <td><span class="badge-provider badge-bls">${state.provider || 'BLS'}</span></td>
                <td>${cities[Math.floor(Math.random() * cities.length)]}</td>
                <td>${new Date(Date.now() + Math.random() * 30 * 864e5).toLocaleDateString('en-GB')}</td>
                <td>${String(8 + Math.floor(Math.random() * 9)).padStart(2,'0')}:${Math.random() < 0.5 ? '00' : '30'}</td>
                <td><span class="badge bg-success">متاح</span></td>
                <td><button class="btn-success-custom btn-sm-custom" onclick="toast('نموذج توضيحي: الحجز يتم عبر الخادم الخلفي','success')">
                    <i class="bi bi-bookmark-check"></i> حجز</button></td>`;
            body.prepend(row);
            $('appointmentsTotal').textContent = state.stats.appointments;
            addLog(`موعد جديد: ${row.cells[2].textContent}`, 'palestine');
            updateStats();
        }

        function refreshAppointments() {
            addLog('تحديث قائمة المواعيد...', 'info');
            toast('تم التحديث', 'info');
        }

        /* ============================================= */
        /* البروكسيات */
        /* ============================================= */
        function addProxy() {
            const val = $('proxyInput').value.trim();
            if (!val) { toast('أدخل عنوان البروكسي', 'warning'); return; }
            state.proxies.push({ addr: val, type: $('proxyType').value, status: 'untested' });
            $('proxyInput').value = '';
            renderProxies();
            addLog(`تمت إضافة بروكسي: ${val}`, 'info');
        }

        function renderProxies() {
            const list = $('proxyList');
            $('proxyCount').textContent = state.proxies.length;
            $('proxyBadge').textContent = state.proxies.length;
            if (!state.proxies.length) {
                list.innerHTML = `<div class="empty-state"><i class="bi bi-shield-lock"></i><div>لا توجد بروكسيات مضافة</div></div>`;
                return;
            }
            list.innerHTML = state.proxies.map((p, i) => `
                <div class="file-item">
                    <div class="file-info">
                        <span class="proxy-status ${p.status === 'working' ? 'proxy-working' : p.status === 'failed' ? 'proxy-failed' : 'proxy-untested'}"></span>
                        <div>
                            <div class="file-name" dir="ltr">${p.addr}</div>
                            <div class="file-size">${p.type.toUpperCase()}</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn-outline-custom btn-sm-custom" onclick="testProxy(${i})">فحص</button>
                        <button class="btn-danger-custom btn-sm-custom" onclick="removeProxy(${i})">حذف</button>
                    </div>
                </div>`).join('');
        }

        function testProxy(i) {
            const p = state.proxies[i];
            addLog(`فحص بروكسي: ${p.addr} ...`, 'info');
            setTimeout(() => {
                p.status = Math.random() > 0.3 ? 'working' : 'failed';
                addLog(`نتيجة الفحص: ${p.addr} → ${p.status === 'working' ? 'يعمل' : 'فاشل'}`,
                    p.status === 'working' ? 'success' : 'error');
                renderProxies();
            }, 800);
        }

        function testAllProxies() {
            if (!state.proxies.length) { toast('لا توجد بروكسيات للفحص', 'warning'); return; }
            addLog(`بدء فحص ${state.proxies.length} بروكسي...`, 'info');
            state.proxies.forEach((_, i) => testProxy(i));
        }

        function removeProxy(i) {
            addLog(`تم حذف بروكسي: ${state.proxies[i].addr}`, 'warning');
            state.proxies.splice(i, 1);
            renderProxies();
        }

        function clearProxies() {
            state.proxies = [];
            renderProxies();
            addLog('تم حذف جميع البروكسيات', 'warning');
        }

        /* ============================================= */
        /* الحسابات */
        /* ============================================= */
        function addAccount() {
            const email = $('accEmail').value.trim();
            const pass = $('accPass').value;
            if (!email || !pass) { toast('أكمل بيانات الحساب', 'warning'); return; }
            state.accounts.push({ provider: $('accProvider').value, email, pass: '••••••' });
            $('accEmail').value = '';
            $('accPass').value = '';
            renderAccounts();
            addLog(`تمت إضافة حساب: ${email}`, 'success');
        }

        function renderAccounts() {
            const list = $('accountList');
            if (!state.accounts.length) {
                list.innerHTML = `<div class="empty-state"><i class="bi bi-person-x"></i><div>لا توجد حسابات مضافة</div></div>`;
                return;
            }
            list.innerHTML = state.accounts.map((a, i) => `
                <div class="file-item">
                    <div class="file-info">
                        <span class="badge-provider badge-${a.provider.toLowerCase()}">${a.provider}</span>
                        <div class="file-name" dir="ltr">${a.email}</div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="file-size" dir="ltr">${a.pass}</span>
                        <button class="btn-danger-custom btn-sm-custom" onclick="removeAccount(${i})">حذف</button>
                    </div>
                </div>`).join('');
        }

        function removeAccount(i) {
            addLog(`تم حذف حساب: ${state.accounts[i].email}`, 'warning');
            state.accounts.splice(i, 1);
            renderAccounts();
        }

        /* ============================================= */
        /* الإعدادات */
        /* ============================================= */
        function saveSettings() {
            addLog('تم حفظ الإعدادات', 'success');
            toast('تم حفظ الإعدادات', 'success');
        }

        /* ============================================= */
        /* التهيئة */
        /* ============================================= */
        document.addEventListener('DOMContentLoaded', () => {
            addLog('تحميل نواة النظام... v2.3.18-Stable', 'info');
            addLog('واجهة الإدارة جاهزة — في وضع العرض التجريبي (Demo)', 'warning');
            renderProxies();
            renderAccounts();
            updateStats();
        });
    </script>
</body>
</html>
