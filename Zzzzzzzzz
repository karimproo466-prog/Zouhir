<script>
// ============================================================
// BLS MANTISX - Agency Portal v2.1
// ✅ مع دوال البوت الكاملة
// ============================================================

// ===== API Configuration =====
const API_BASE = 'http://127.0.0.1:5000/api';

// ===== State =====
const state = {
    clients: [],
    bookings: [],
    logs: [],
    proxies: [],
    stats: { captchas: 0 },
    settings: {
        telegram: { token: '', chatId: '' },
        bls: { email: '', password: '' }
    },
    tempRegPhotos: { photo: null, passportPhoto: null },
    currentPhotoClient: null,
    filters: { clients: '' }
};

// ⭐ المراكز مع الناظور
const CENTERS = {
    'Spain': ['الناظور', 'الرباط', 'الدار البيضاء', 'مراكش', 'طنجة', 'أكادير', 'فاس', 'وجدة', 'تطوان', 'القنيطرة', 'سلا', 'الجديدة', 'بني ملال'],
    'France': ['الرباط', 'الدار البيضاء', 'مراكش', 'طنجة', 'أكادير', 'فاس'],
    'Italy': ['الرباط', 'الدار البيضاء', 'مراكش'],
    'Germany': ['الرباط', 'الدار البيضاء', 'مراكش'],
    'Portugal': ['الرباط', 'الدار البيضاء', 'مراكش'],
    'Netherlands': ['الرباط', 'الدار البيضاء'],
    'Belgium': ['الرباط', 'الدار البيضاء']
};

const COUNTRY_NAMES = {
    'Spain': 'إسبانيا', 'France': 'فرنسا', 'Italy': 'إيطاليا', 
    'Germany': 'ألمانيا', 'Portugal': 'البرتغال', 'Netherlands': 'هولندا',
    'Belgium': 'بلجيكا'
};

// ============================================================
// 🚀 BOT CONTROL - دوال البوت
// ============================================================

async function startBotForClient(clientId, clientName) {
    if (!confirm(`⚠️ تشغيل البوت للزبون: ${clientName}?\n\nسيفتح Chrome تلقائياً ويسجل الدخول لموقع BLS`)) {
        return;
    }
    
    log('SYSTEM', `🚀 تشغيل البوت لـ: ${clientName}`);
    
    try {
        // إرسال أمر التشغيل للخادم
        const res = await fetch(`${API_BASE}/bot/start`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ client_id: clientId })
        });
        
        const data = await res.json();
        
        if (data.success) {
            log('SUCCESS', `✅ تم تشغيل البوت: ${clientName}`);
            alert(`✅ تم تشغيل البوت!\n\nالمتصفح سيفتح خلال ثوانٍ\nتابع السجلات لرؤية ما يحدث`);
            
            document.getElementById('headerStatus').textContent = '🤖 يعمل';
            startLogsPolling();
        } else {
            log('ERROR', `❌ فشل: ${data.error}`);
            alert(`❌ فشل التشغيل\n\n${data.error}`);
        }
    } catch (err) {
        log('ERROR', `❌ لا يمكن الاتصال بالخادم`);
        alert(`❌ لا يمكن الاتصال بالخادم!\n\nتأكد من تشغيل:\npython app.py\n\nالخطأ: ${err.message}`);
    }
}

async function stopBot() {
    try {
        const res = await fetch(`${API_BASE}/bot/stop`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            log('WARNING', '⏹ تم إيقاف البوت');
            document.getElementById('headerStatus').textContent = 'جاهز للعمل';
            alert('⏹ تم إيقاف البوت');
        }
    } catch (e) {
        log('ERROR', '❌ فشل الإيقاف');
    }
}

let logsInterval = null;

function startLogsPolling() {
    if (logsInterval) clearInterval(logsInterval);
    logsInterval = setInterval(async () => {
        try {
            const res = await fetch(`${API_BASE}/logs?limit=200`);
            const logs = await res.json();
            if (Array.isArray(logs)) {
                state.logs = logs;
                renderLogs();
            }
            
            const statusRes = await fetch(`${API_BASE}/status`);
            const status = await statusRes.json();
            if (status.running) {
                document.getElementById('headerStatus').textContent = '🤖 يعمل';
            } else {
                document.getElementById('headerStatus').textContent = 'جاهز للعمل';
            }
        } catch (e) {}
    }, 3000);
}

async function testServerConnection() {
    try {
        const res = await fetch(`${API_BASE}/status`);
        const data = await res.json();
        log('SUCCESS', '✅ متصل بالخادم');
        return true;
    } catch (e) {
        log('ERROR', '❌ الخادم غير متصل - شغّل: python app.py');
        return false;
    }
}

// ============================================================
// Logging
// ============================================================
function log(level, message) {
    const now = new Date();
    const time = now.toLocaleTimeString('en-GB');
    state.logs.push({ time, level, message, timestamp: now.toISOString() });
    if (state.logs.length > 500) state.logs.shift();
    renderLogs();
    saveState();
}

function renderLogs() {
    const console = document.getElementById('logConsole');
    if (!console) return;
    if (state.logs.length === 0) {
        console.innerHTML = `<div class="log-line INFO"><span class="time">[--:--:--]</span><span class="level">[INFO]</span><span class="msg">System ready</span></div>`;
        return;
    }
    const html = state.logs.slice(-100).map(l => `
        <div class="log-line ${l.level}">
            <span class="time">[${l.time}]</span>
            <span class="level">[${l.level}]</span>
            <span class="msg">${l.message}</span>
        </div>
    `).join('');
    console.innerHTML = html;
    console.scrollTop = console.scrollHeight;
}

function clearLogs() {
    if (!confirm('مسح السجلات؟')) return;
    state.logs = [];
    saveState();
    renderLogs();
}

// ============================================================
// Navigation
// ============================================================
function showPage(pageId, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const page = document.getElementById('page-' + pageId);
    if (page) page.classList.add('active');
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    
    if (pageId === 'photos') populatePhotoSelect();
    if (pageId === 'proxies') renderProxies();
    if (pageId === 'dashboard') updateStats();
    if (pageId === 'clients') renderClients();
    if (pageId === 'bookings') renderBookings();
    if (pageId === 'logs') renderLogs();
    
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ============================================================
// Statistics
// ============================================================
function updateStats() {
    const complete = state.clients.filter(c => c.photo && c.passportPhoto).length;
    const working = state.proxies.filter(p => p.status === 'working').length;
    
    document.getElementById('statClients').textContent = state.clients.length;
    document.getElementById('statComplete').textContent = complete;
    document.getElementById('statProxies').textContent = working;
    document.getElementById('statBookings').textContent = state.bookings.length;
    
    document.getElementById('clientsCount').textContent = state.clients.length;
    document.getElementById('bookingsCount').textContent = state.bookings.length;
    document.getElementById('clientsListCount').textContent = state.clients.length;
    document.getElementById('proxiesCount').textContent = state.proxies.length;
}

// ============================================================
// Register Photos
// ============================================================
function handleRegPhoto(event, type) {
    const file = event.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { alert('⚠️ اختر صورة'); return; }
    if (file.size > 5 * 1024 * 1024) { alert('⚠️ الحد 5MB'); return; }
    
    const reader = new FileReader();
    reader.onload = (e) => {
        const base64 = e.target.result;
        if (type === 'photo') {
            state.tempRegPhotos.photo = base64;
            updateRegPhotoZone('regPhotoZone', base64, 'الصورة الشخصية');
        } else {
            state.tempRegPhotos.passportPhoto = base64;
            updateRegPhotoZone('regPassportZone', base64, 'صورة الجواز');
        }
        log('SUCCESS', `📸 صورة محملة`);
    };
    reader.readAsDataURL(file);
}

function updateRegPhotoZone(zoneId, base64, label) {
    const zone = document.getElementById(zoneId);
    if (!zone) return;
    zone.classList.add('has-file');
    const isPhoto = zoneId === 'regPhotoZone';
    const inputId = isPhoto ? 'regPhotoFile' : 'regPassportFile';
    const type = isPhoto ? 'photo' : 'passport';
    
    zone.innerHTML = `
        <input type="file" id="${inputId}" accept="image/*" onchange="handleRegPhoto(event, '${type}')">
        <div class="check-badge"><i class="bi bi-check-lg"></i></div>
        <button class="remove-btn" onclick="event.stopPropagation(); removeRegPhoto('${type}')">
            <i class="bi bi-x-lg"></i>
        </button>
        <img src="${base64}" class="preview">
        <div class="title" style="margin-top:0.5rem;">✅ ${label}</div>
    `;
}

function removeRegPhoto(type) {
    if (type === 'photo') {
        state.tempRegPhotos.photo = null;
        resetRegPhotoZone('regPhotoZone', 'regPhotoFile', 'photo', 'الصورة الشخصية', 'bi-person-square');
    } else {
        state.tempRegPhotos.passportPhoto = null;
        resetRegPhotoZone('regPassportZone', 'regPassportFile', 'passport', 'جواز السفر', 'bi-card-text');
    }
}

function resetRegPhotoZone(zoneId, inputId, type, title, icon) {
    const zone = document.getElementById(zoneId);
    if (!zone) return;
    zone.classList.remove('has-file');
    zone.innerHTML = `
        <input type="file" id="${inputId}" accept="image/*" onchange="handleRegPhoto(event, '${type}')">
        <i class="bi ${icon} big-icon"></i>
        <div class="title">${title}</div>
    `;
}

// ============================================================
// Save Client
// ============================================================
function updateRegCenters() {
    const country = document.getElementById('regDestination').value;
    const select = document.getElementById('regCenter');
    select.innerHTML = '<option value="">-- اختر المركز --</option>';
    if (COUNTRY_NAMES[country]) {
        CENTERS[country].forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            select.appendChild(opt);
        });
    }
}

async function saveNewClient() {
    const name = document.getElementById('regName').value.trim();
    const passport = document.getElementById('regPassport').value.trim().toUpperCase();
    const phone = document.getElementById('regPhone').value.trim();
    const destination = document.getElementById('regDestination').value;
    const center = document.getElementById('regCenter').value;
    
    if (!name || !passport || !phone || !destination || !center) {
        alert('⚠️ املأ الحقول الإلزامية');
        return;
    }
    
    if (state.clients.find(c => c.passport === passport)) {
        alert('⚠️ الجواز موجود مسبقاً!');
        return;
    }
    
    const client = {
        id: 'c_' + Date.now(),
        name,
        nameLatin: document.getElementById('regNameLatin').value.trim().toUpperCase(),
        passport,
        passportIssue: document.getElementById('regPassportIssue').value,
        passportExpiry: document.getElementById('regPassportExpiry').value,
        dob: document.getElementById('regDob').value,
        birthPlace: document.getElementById('regBirthPlace').value.trim(),
        nationality: document.getElementById('regNationality').value,
        gender: document.getElementById('regGender').value,
        city: document.getElementById('regCity').value.trim(),
        phone,
        email: document.getElementById('regEmail').value.trim(),
        address: document.getElementById('regAddress').value.trim(),
        destination,
        center,
        visaType: document.getElementById('regVisaType').value,
        duration: document.getElementById('regDuration').value,
        entries: document.getElementById('regEntries').value,
        budget: document.getElementById('regBudget').value.trim(),
        notes: document.getElementById('regNotes').value.trim(),
        photo: state.tempRegPhotos.photo,
        passportPhoto: state.tempRegPhotos.passportPhoto,
        status: 'active',
        createdAt: new Date().toISOString()
    };
    
    state.clients.push(client);
    saveState();
    updateStats();
    
    // إرسال للخادم إذا كان يعمل
    try {
        await fetch(`${API_BASE}/clients`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(client)
        });
    } catch (e) {
        console.log('Offline mode - saved locally');
    }
    
    log('SUCCESS', `✅ زبون: ${name}`);
    alert(`✅ تم حفظ الزبون!\n\n👤 ${name}\n🪪 ${passport}\n🎯 ${COUNTRY_NAMES[destination]} - ${center}`);
    
    resetRegisterForm();
    showPage('clients', document.querySelectorAll('.nav-btn')[2]);
}

function resetRegisterForm() {
    ['regName','regNameLatin','regPassport','regPassportIssue','regPassportExpiry',
     'regDob','regBirthPlace','regCity','regPhone','regEmail','regAddress',
     'regDuration','regBudget','regNotes'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    
    document.getElementById('regDestination').value = '';
    document.getElementById('regCenter').innerHTML = '<option value="">-- اختر الدولة أولاً --</option>';
    document.getElementById('regVisaType').value = 'Tourism';
    document.getElementById('regNationality').value = 'المغرب';
    document.getElementById('regGender').value = 'ذكر';
    
    state.tempRegPhotos = { photo: null, passportPhoto: null };
    resetRegPhotoZone('regPhotoZone', 'regPhotoFile', 'photo', 'الصورة الشخصية', 'bi-person-square');
    resetRegPhotoZone('regPassportZone', 'regPassportFile', 'passport', 'جواز السفر', 'bi-card-text');
}

// ============================================================
// Render Clients
// ============================================================
function renderClients(filter = '') {
    const tbody = document.getElementById('clientsTableBody');
    if (!tbody) return;
    
    let list = state.clients;
    if (filter) {
        const q = filter.toLowerCase();
        list = list.filter(c => 
            c.name.toLowerCase().includes(q) || 
            c.passport.toLowerCase().includes(q) ||
            (c.phone && c.phone.includes(q))
        );
    }
    
    if (list.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="7">
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>${filter ? 'لا توجد نتائج' : 'لا يوجد زبائن'}</p>
                    </div>
                </td>
            </tr>
        `;
        return;
    }
    
    tbody.innerHTML = list.map((c, i) => {
        const photoCount = (c.photo ? 1 : 0) + (c.passportPhoto ? 1 : 0);
        let photoBadge;
        if (photoCount === 2) photoBadge = '<span class="badge-blk badge-success-blk">✅ 2/2</span>';
        else if (photoCount === 1) photoBadge = '<span class="badge-blk badge-warning-blk">⚠️ 1/2</span>';
        else photoBadge = '<span class="badge-blk badge-danger-blk">❌ 0/2</span>';
        
        return `
            <tr>
                <td>${i + 1}</td>
                <td><strong>${c.name}</strong></td>
                <td><code style="color:var(--primary); font-weight:700;">${c.passport}</code></td>
                <td dir="ltr" style="text-align:right;">${c.phone || '--'}</td>
                <td>${COUNTRY_NAMES[c.destination] || '--'}</td>
                <td>${photoBadge}</td>
                <td>
                    <button class="btn-blk btn-success-blk btn-sm-blk" onclick="startBotForClient('${c.id}', '${c.name}')" title="تشغيل البوت">
                        <i class="bi bi-play-fill"></i> تشغيل
                    </button>
                    <button class="btn-blk btn-outline-blk btn-sm-blk" onclick="goToPhotos('${c.id}')" title="صور">
                        <i class="bi bi-images"></i>
                    </button>
                    <button class="btn-blk btn-info-blk btn-sm-blk" onclick="viewClient('${c.id}')" title="عرض">
                        <i class="bi bi-eye-fill"></i>
                    </button>
                    <button class="btn-blk btn-danger-blk btn-sm-blk" onclick="deleteClient('${c.id}')" title="حذف">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

function filterClients(q) {
    state.filters.clients = q;
    renderClients(q);
}

function viewClient(id) {
    const c = state.clients.find(x => x.id === id);
    if (!c) return;
    alert(`📋 ${c.name}\n🪪 ${c.passport}\n📱 ${c.phone}\n🎯 ${COUNTRY_NAMES[c.destination]} - ${c.center}`);
}

function deleteClient(id) {
    const client = state.clients.find(c => c.id === id);
    if (!client) return;
    if (!confirm(`حذف "${client.name}"؟`)) return;
    state.clients = state.clients.filter(c => c.id !== id);
    saveState();
    renderClients();
    updateStats();
}

function goToPhotos(clientId) {
    showPage('photos', document.querySelectorAll('.nav-btn')[3]);
    setTimeout(() => {
        document.getElementById('photoClientSelect').value = clientId;
        loadClientPhotos();
    }, 100);
}

// ============================================================
// Photos
// ============================================================
function populatePhotoSelect() {
    const select = document.getElementById('photoClientSelect');
    if (!select) return;
    select.innerHTML = '<option value="">-- اختر --</option>';
    state.clients.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.name} (${c.passport})`;
        select.appendChild(opt);
    });
}

function loadClientPhotos() {
    const clientId = document.getElementById('photoClientSelect').value;
    const card = document.getElementById('photosCard');
    if (!clientId) { card.classList.add('hidden'); return; }
    const client = state.clients.find(c => c.id === clientId);
    if (!client) return;
    state.currentPhotoClient = client;
    card.classList.remove('hidden');
    document.getElementById('photoClientName').textContent = client.name;
    renderPhotoZones(client);
}

function renderPhotoZones(client) {
    const photoZone = document.getElementById('photoZone');
    if (client.photo) {
        photoZone.classList.add('has-file');
        photoZone.innerHTML = `<input type="file" id="photoFile" accept="image/*" onchange="handlePhotoUpload(event, 'photo')"><img src="${client.photo}" class="preview">`;
    }
    
    const passportZone = document.getElementById('passportZone');
    if (client.passportPhoto) {
        passportZone.classList.add('has-file');
        passportZone.innerHTML = `<input type="file" id="passportFile" accept="image/*" onchange="handlePhotoUpload(event, 'passport')"><img src="${client.passportPhoto}" class="preview">`;
    }
}

function handlePhotoUpload(event, type) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        if (type === 'photo') state.currentPhotoClient.photo = e.target.result;
        else state.currentPhotoClient.passportPhoto = e.target.result;
        saveState();
        renderPhotoZones(state.currentPhotoClient);
        updateStats();
        renderClients(state.filters.clients);
    };
    reader.readAsDataURL(file);
}

// ============================================================
// PROXIES
// ============================================================
function openAddProxyModal() {
    document.getElementById('addProxyModal').classList.remove('hidden');
}

function closeProxyModal() {
    document.getElementById('addProxyModal').classList.add('hidden');
    ['proxyHost','proxyPort','proxyCountry'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
}

function saveProxy() {
    const host = document.getElementById('proxyHost').value.trim();
    const port = document.getElementById('proxyPort').value.trim();
    
    if (!host || !port) { alert('⚠️ املأ الحقول'); return; }
    
    const proxy = {
        id: 'p_' + Date.now(),
        host, port: parseInt(port),
        type: document.getElementById('proxyType').value,
        country: document.getElementById('proxyCountry').value.trim().toUpperCase(),
        status: 'untested',
        createdAt: new Date().toISOString()
    };
    
    state.proxies.push(proxy);
    saveState();
    renderProxies();
    updateStats();
    closeProxyModal();
    log('SUCCESS', `🛡️ ${host}:${port}`);
}

function deleteProxy(id) {
    if (!confirm('حذف؟')) return;
    state.proxies = state.proxies.filter(x => x.id !== id);
    saveState();
    renderProxies();
    updateStats();
}

function testProxy(id) {
    const p = state.proxies.find(x => x.id === id);
    if (!p) return;
    p.status = 'testing';
    renderProxies();
    setTimeout(() => {
        p.status = Math.random() > 0.3 ? 'working' : 'failed';
        saveState();
        renderProxies();
        updateStats();
    }, 1500);
}

function testAllProxies() {
    if (state.proxies.length === 0) { alert('لا توجد بروكسيات'); return; }
    state.proxies.forEach((p, i) => {
        setTimeout(() => {
            p.status = Math.random() > 0.3 ? 'working' : 'failed';
            saveState();
            renderProxies();
        }, 500 + i * 300);
    });
}

function renderProxies() {
    const container = document.getElementById('proxiesList');
    if (!container) return;
    
    const total = state.proxies.length;
    const working = state.proxies.filter(p => p.status === 'working').length;
    const failed = state.proxies.filter(p => p.status === 'failed').length;
    
    document.getElementById('proxyTotal').textContent = total;
    document.getElementById('proxyWorking').textContent = working;
    document.getElementById('proxyFailed').textContent = failed;
    document.getElementById('proxiesListCount').textContent = total;
    
    if (total === 0) {
        container.innerHTML = `<div class="empty-state"><i class="bi bi-shield-slash"></i><p>لا توجد بروكسيات</p></div>`;
        return;
    }
    
    container.innerHTML = state.proxies.map(p => `
        <div class="proxy-row">
            <span class="proxy-status proxy-${p.status}"></span>
            <span class="proxy-address">${p.host}:${p.port}</span>
            <span class="badge-blk badge-info-blk">${p.type}</span>
            <button class="btn-blk btn-info-blk btn-sm-blk" onclick="testProxy('${p.id}')">
                <i class="bi bi-lightning-charge-fill"></i>
            </button>
            <button class="btn-blk btn-danger-blk btn-sm-blk" onclick="deleteProxy('${p.id}')">
                <i class="bi bi-trash-fill"></i>
            </button>
        </div>
    `).join('');
}

// ============================================================
// CAPTCHA
// ============================================================
function loadCaptchaImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        document.getElementById('captchaDisplay').innerHTML = `<img src="${e.target.result}">`;
        document.getElementById('captchaInput').focus();
    };
    reader.readAsDataURL(file);
}

function submitCaptcha() {
    const code = document.getElementById('captchaInput').value.trim().toUpperCase();
    if (!code) { alert('⚠️ أدخل الرمز'); return; }
    
    state.stats.captchas++;
    saveState();
    log('SUCCESS', `✅ كابتشا: ${code}`);
    
    navigator.clipboard.writeText(code).then(() => {
        alert(`✅ ${code}\n📋 تم النسخ`);
    }).catch(() => {
        alert(`✅ ${code}`);
    });
    
    document.getElementById('captchaInput').value = '';
}

// ============================================================
// BOOKINGS
// ============================================================
function renderBookings() {
    const tbody = document.getElementById('bookingsTableBody');
    if (!tbody) return;
    if (state.bookings.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state"><i class="bi bi-calendar-x"></i><p>لا توجد حجوزات</p></div></td></tr>`;
        return;
    }
    tbody.innerHTML = state.bookings.map((b, i) => `
        <tr>
            <td>${i + 1}</td>
            <td><code>${b.reference}</code></td>
            <td>${b.clientName}</td>
            <td>${COUNTRY_NAMES[b.destination] || b.destination}</td>
            <td>${b.date}</td>
            <td><span class="badge-blk badge-success-blk">محجوز</span></td>
        </tr>
    `).join('');
}

// ============================================================
// SETTINGS
// ============================================================
function saveTelegramSettings() {
    state.settings.telegram = {
        token: document.getElementById('setTgToken').value.trim(),
        chatId: document.getElementById('setTgChatId').value.trim()
    };
    saveState();
    alert('✅ تم الحفظ');
}

function saveBlsSettings() {
    state.settings.bls = {
        email: document.getElementById('setBlsEmail').value.trim(),
        password: document.getElementById('setBlsPassword').value
    };
    saveState();
    alert('✅ تم الحفظ');
}

// ============================================================
// EXPORT/IMPORT
// ============================================================
function exportData() {
    const data = {
        version: '2.1',
        exportedAt: new Date().toISOString(),
        clients: state.clients,
        bookings: state.bookings,
        proxies: state.proxies,
        settings: state.settings
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `bls_backup_${new Date().toISOString().slice(0,10)}.json`;
    a.click();
}

function importData() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    input.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
            try {
                const data = JSON.parse(ev.target.result);
                if (data.clients) state.clients = data.clients;
                if (data.bookings) state.bookings = data.bookings;
                if (data.proxies) state.proxies = data.proxies;
                saveState();
                location.reload();
            } catch (err) { alert('خطأ: ' + err.message); }
        };
        reader.readAsText(file);
    };
    input.click();
}

function clearAllData() {
    if (!confirm('حذف كل البيانات؟')) return;
    localStorage.removeItem('bls_mantisx_v2');
    location.reload();
}

// ============================================================
// SAVE/LOAD
// ============================================================
function saveState() {
    const data = {
        clients: state.clients,
        bookings: state.bookings,
        proxies: state.proxies,
        logs: state.logs,
        settings: state.settings,
        stats: state.stats
    };
    try {
        localStorage.setItem('bls_mantisx_v2', JSON.stringify(data));
    } catch (e) {}
}

function loadState() {
    const saved = localStorage.getItem('bls_mantisx_v2');
    if (!saved) return;
    try {
        const data = JSON.parse(saved);
        state.clients = data.clients || [];
        state.bookings = data.bookings || [];
        state.proxies = data.proxies || [];
        state.logs = data.logs || [];
        state.settings = data.settings || state.settings;
        state.stats = data.stats || { captchas: 0 };
    } catch (e) {}
}

// ============================================================
// CLOCK
// ============================================================
function updateClock() {
    const now = new Date();
    document.getElementById('headerDate').textContent = now.toLocaleDateString('ar-EG', { weekday: 'short', month: 'short', day: 'numeric' });
    document.getElementById('headerTime').textContent = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
}

// ============================================================
// INIT
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
    loadState();
    updateStats();
    renderClients();
    renderBookings();
    renderProxies();
    renderLogs();
    updateClock();
    setInterval(updateClock, 30000);
    
    log('SYSTEM', '🚀 BLS MANTISX v2.1');
    
    // اختبار الاتصال بالخادم
    setTimeout(testServerConnection, 1000);
});

window.addEventListener('beforeunload', () => saveState());
</script>

