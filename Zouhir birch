<script>
// ==========================================
// BLS MANTISX - Agency Portal v2.0
// Complete System
// ==========================================

// ===== State =====
const state = {
    clients: [],
    bookings: [],
    logs: [],
    stats: { captchas: 0 },
    settings: {
        agency: { name: '', phone: '', email: '', license: '' },
        telegram: { token: '', chatId: '' },
        bls: { email: '', password: '' }
    },
    currentPhotoClient: null,
    captchaMethod: 'manual',
    captchaApiKey: '',
    filters: { clients: '' }
};

// ===== Centers Data =====
const CENTERS = {
    'Spain': ['الرباط', 'الدار البيضاء', 'مراكش', 'طنجة', 'أكادير', 'فاس'],
    'France': ['الرباط', 'الدار البيضاء', 'مراكش'],
    'Italy': ['الرباط', 'الدار البيضاء'],
    'Germany': ['الرباط', 'الدار البيضاء'],
    'Portugal': ['الرباط', 'الدار البيضاء'],
    'Netherlands': ['الرباط', 'الدار البيضاء'],
    'Belgium': ['الرباط', 'الدار البيضاء'],
    'Switzerland': ['الرباط', 'الدار البيضاء']
};

const COUNTRY_NAMES = {
    'Spain': 'إسبانيا', 'France': 'فرنسا', 'Italy': 'إيطاليا', 
    'Germany': 'ألمانيا', 'Portugal': 'البرتغال', 'Netherlands': 'هولندا',
    'Belgium': 'بلجيكا', 'Switzerland': 'سويسرا'
};

const VISA_NAMES = {
    'Tourism': 'سياحة', 'Business': 'عمل', 'Student': 'دراسة',
    'Family': 'زيارة عائلية', 'Medical': 'علاج', 'Transit': 'ترانزيت'
};

// ===== Logging =====
function log(level, message) {
    const now = new Date();
    const time = now.toLocaleTimeString('en-GB');
    
    state.logs.push({ time, level, message, timestamp: now.toISOString() });
    if (state.logs.length > 500) state.logs.shift();
    
    renderLogs();
    saveState();
}

function renderLogs() {
    const console = document.getElementById('logConsole');
    if (!console) return;
    
    if (state.logs.length === 0) {
        console.innerHTML = `
            <div class="log-line INFO">
                <span class="time">[--:--:--]</span>
                <span class="level">[INFO]</span>
                <span class="msg">System initialized</span>
            </div>
        `;
        return;
    }
    
    const html = state.logs.slice(-100).map(l => `
        <div class="log-line ${l.level}">
            <span class="time">[${l.time}]</span>
            <span class="level">[${l.level}]</span>
            <span class="msg">${l.message}</span>
        </div>
    `).join('');
    
    console.innerHTML = html;
    console.scrollTop = console.scrollHeight;
}

function clearLogs() {
    if (!confirm('مسح جميع السجلات؟')) return;
    state.logs = [];
    saveState();
    renderLogs();
    log('INFO', 'تم مسح السجلات');
}

function exportLogs() {
    const text = state.logs.map(l => `[${l.time}] [${l.level}] ${l.message}`).join('\n');
    downloadFile(text, 'logs.txt', 'text/plain');
    log('SUCCESS', 'تم تصدير السجلات');
}

// ===== Navigation =====
function showPage(pageId, btn) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const page = document.getElementById('page-' + pageId);
    if (page) page.classList.add('active');
    
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    
    // Page-specific actions
    if (pageId === 'photos') populatePhotoSelect();
    if (pageId === 'dashboard') updateStats();
    if (pageId === 'clients') renderClients();
    if (pageId === 'bookings') renderBookings();
    if (pageId === 'logs') renderLogs();
    
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ===== Statistics =====
function updateStats() {
    const complete = state.clients.filter(c => c.photo && c.passportPhoto).length;
    
    document.getElementById('statClients').textContent = state.clients.length;
    document.getElementById('statComplete').textContent = complete;
    document.getElementById('statCaptchas').textContent = state.stats.captchas;
    document.getElementById('statBookings').textContent = state.bookings.length;
    document.getElementById('clientsCount').textContent = state.clients.length;
    document.getElementById('bookingsCount').textContent = state.bookings.length;
    document.getElementById('clientsListCount').textContent = state.clients.length;
}

// ===== Register Client =====
function updateRegCenters() {
    const country = document.getElementById('regDestination').value;
    const select = document.getElementById('regCenter');
    
    select.innerHTML = '<option value="">-- اختر المركز --</option>';
    
    if (COUNTRY_NAMES[country]) {
        CENTERS[country].forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            select.appendChild(opt);
        });
    }
}

function saveNewClient() {
    // Validation
    const name = document.getElementById('regName').value.trim();
    const passport = document.getElementById('regPassport').value.trim().toUpperCase();
    const phone = document.getElementById('regPhone').value.trim();
    const destination = document.getElementById('regDestination').value;
    const center = document.getElementById('regCenter').value;
    const visaType = document.getElementById('regVisaType').value;
    
    if (!name) { alert('⚠️ الاسم الكامل مطلوب'); return; }
    if (!passport) { alert('⚠️ رقم الجواز مطلوب'); return; }
    if (!phone) { alert('⚠️ رقم الهاتف مطلوب'); return; }
    if (!destination) { alert('⚠️ اختر الدولة'); return; }
    if (!center) { alert('⚠️ اختر المركز'); return; }
    
    // Check duplicate
    if (state.clients.find(c => c.passport === passport)) {
        alert('⚠️ رقم الجواز مسجل مسبقاً!');
        return;
    }
    
    const client = {
        id: 'c_' + Date.now(),
        name,
        nameLatin: document.getElementById('regNameLatin').value.trim().toUpperCase(),
        passport,
        passportIssue: document.getElementById('regPassportIssue').value,
        passportExpiry: document.getElementById('regPassportExpiry').value,
        dob: document.getElementById('regDob').value,
        birthPlace: document.getElementById('regBirthPlace').value.trim(),
        nationality: document.getElementById('regNationality').value,
        gender: document.getElementById('regGender').value,
        marital: document.getElementById('regMarital').value,
        city: document.getElementById('regCity').value.trim(),
        phone,
        phone2: document.getElementById('regPhone2').value.trim(),
        email: document.getElementById('regEmail').value.trim(),
        address: document.getElementById('regAddress').value.trim(),
        destination,
        center,
        visaType,
        duration: document.getElementById('regDuration').value,
        entries: document.getElementById('regEntries').value,
        budget: document.getElementById('regBudget').value.trim(),
        notes: document.getElementById('regNotes').value.trim(),
        emergencyName: document.getElementById('regEmergencyName').value.trim(),
        emergencyPhone: document.getElementById('regEmergencyPhone').value.trim(),
        photo: null,
        passportPhoto: null,
        status: 'active',
        createdAt: new Date().toISOString()
    };
    
    state.clients.push(client);
    saveState();
    updateStats();
    
    log('SUCCESS', `✅ تم تسجيل زبون جديد: ${name}`);
    
    alert(`✅ تم حفظ الزبون بنجاح!\n\n📋 الاسم: ${name}\n🪪 الجواز: ${passport}\n🎯 الوجهة: ${COUNTRY_NAMES[destination]} - ${center}\n\n💡 الخطوة التالية: ارفع صوره من صفحة "صور الزبائن"`);
    
    resetRegisterForm();
    showPage('clients', document.querySelectorAll('.nav-btn')[2]);
}

function resetRegisterForm() {
    const fields = ['regName','regNameLatin','regPassport','regPassportIssue','regPassportExpiry',
                    'regDob','regBirthPlace','regCity','regPhone','regPhone2','regEmail','regAddress',
                    'regDuration','regBudget','regNotes','regEmergencyName','regEmergencyPhone'];
    
    fields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    
    document.getElementById('regDestination').value = '';
    document.getElementById('regCenter').innerHTML = '<option value="">-- اختر الدولة أولاً --</option>';
    document.getElementById('regVisaType').value = 'Tourism';
    document.getElementById('regNationality').value = 'المغرب';
    document.getElementById('regGender').value = 'ذكر';
}

// ===== Render Clients =====
function renderClients(filter = '') {
    const tbody = document.getElementById('clientsTableBody');
    if (!tbody) return;
    
    let list = state.clients;
    if (filter) {
        const q = filter.toLowerCase();
        list = list.filter(c => 
            c.name.toLowerCase().includes(q) || 
            c.passport.toLowerCase().includes(q) ||
            (c.phone && c.phone.includes(q))
        );
    }
    
    if (list.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="8">
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>${filter ? 'لا توجد نتائج للبحث' : 'لا يوجد زبائن بعد'}</p>
                        <p class="hint">${filter ? 'جرب كلمة بحث أخرى' : 'اضغط "تسجيل زبون جديد"'}</p>
                    </div>
                </td>
            </tr>
        `;
        return;
    }
    
    tbody.innerHTML = list.map((c, i) => {
        const photoCount = (c.photo ? 1 : 0) + (c.passportPhoto ? 1 : 0);
        let photoBadge;
        if (photoCount === 2) photoBadge = '<span class="badge-blk badge-success-blk"><i class="bi bi-check-circle-fill"></i> مكتمل</span>';
        else if (photoCount === 1) photoBadge = '<span class="badge-blk badge-warning-blk"><i class="bi bi-exclamation-triangle-fill"></i> 1/2</span>';
        else photoBadge = '<span class="badge-blk badge-danger-blk"><i class="bi bi-x-circle-fill"></i> 0/2</span>';
        
        return `
            <tr>
                <td>${i + 1}</td>
                <td>
                    <strong>${c.name}</strong>
                    ${c.nameLatin ? `<br><small style="color:var(--text-sec); font-size:0.75rem;">${c.nameLatin}</small>` : ''}
                </td>
                <td><code style="color:var(--primary); font-weight:700;">${c.passport}</code></td>
                <td dir="ltr" style="text-align:right;">${c.phone || '--'}</td>
                <td>${COUNTRY_NAMES[c.destination] || c.destination || '--'}</td>
                <td>${photoBadge}</td>
                <td><span class="badge-blk badge-success-blk">نشط</span></td>
                <td>
                    <button class="btn-blk btn-outline-blk btn-sm-blk" onclick="goToPhotos('${c.id}')" title="صور">
                        <i class="bi bi-images"></i>
                    </button>
                    <button class="btn-blk btn-info-blk btn-sm-blk" onclick="viewClient('${c.id}')" title="عرض">
                        <i class="bi bi-eye-fill"></i>
                    </button>
                    <button class="btn-blk btn-danger-blk btn-sm-blk" onclick="deleteClient('${c.id}')" title="حذف">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </td>
            </tr>
        `;
    }).join('');
}

function filterClients(q) {
    state.filters.clients = q;
    renderClients(q);
}

function viewClient(id) {
    const c = state.clients.find(x => x.id === id);
    if (!c) return;
    
    const msg = `
📋 بيانات الزبون
━━━━━━━━━━━━━━━━━━━━
👤 الاسم: ${c.name}
${c.nameLatin ? `🔤 الاسم اللاتيني: ${c.nameLatin}\n` : ''}🪪 الجواز: ${c.passport}
${c.passportExpiry ? `📅 انتهاء الجواز: ${c.passportExpiry}\n` : ''}📱 الهاتف: ${c.phone}
${c.email ? `📧 البريد: ${c.email}\n` : ''}🎂 الميلاد: ${c.dob || '--'}
🌍 الجنسية: ${c.nationality || '--'}
🏠 المدينة: ${c.city || '--'}
━━━━━━━━━━━━━━━━━━━━
🎯 الوجهة: ${COUNTRY_NAMES[c.destination] || '--'}
🏢 المركز: ${c.center || '--'}
🛂 التأشيرة: ${VISA_NAMES[c.visaType] || '--'}
⏱ المدة: ${c.duration || '--'} يوم
━━━━━━━━━━━━━━━━━━━━
📸 صورة شخصية: ${c.photo ? '✅' : '❌'}
🛂 صورة الجواز: ${c.passportPhoto ? '✅' : '❌'}
━━━━━━━━━━━━━━━━━━━━
📝 ملاحظات: ${c.notes || '--'}
    `;
    
    alert(msg);
}

function deleteClient(id) {
    const client = state.clients.find(c => c.id === id);
    if (!client) return;
    
    if (!confirm(`⚠️ حذف الزبون "${client.name}"؟\n\nلا يمكن التراجع!`)) return;
    
    state.clients = state.clients.filter(c => c.id !== id);
    saveState();
    renderClients();
    updateStats();
    log('WARNING', `🗑️ تم حذف الزبون: ${client.name}`);
}

// ===== Photos =====
function populatePhotoSelect() {
    const select = document.getElementById('photoClientSelect');
    if (!select) return;
    
    select.innerHTML = '<option value="">-- اختر زبوناً من القائمة --</option>';
    
    if (state.clients.length === 0) {
        select.innerHTML += '<option value="" disabled>لا يوجد زبائن مسجلون</option>';
        return;
    }
    
    state.clients.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.name} (${c.passport})`;
        select.appendChild(opt);
    });
}

function loadClientPhotos() {
    const clientId = document.getElementById('photoClientSelect').value;
    const card = document.getElementById('photosCard');
    
    if (!clientId) {
        card.classList.add('hidden');
        return;
    }
    
    const client = state.clients.find(c => c.id === clientId);
    if (!client) return;
    
    state.currentPhotoClient = client;
    card.classList.remove('hidden');
    document.getElementById('photoClientName').textContent = client.name;
    
    renderPhotoZones(client);
}

function renderPhotoZones(client) {
    // Personal Photo
    const photoZone = document.getElementById('photoZone');
    if (client.photo) {
        photoZone.classList.add('has-file');
        photoZone.innerHTML = `
            <input type="file" id="photoFile" accept="image/*" onchange="handlePhotoUpload(event, 'photo')">
            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
            <img src="${client.photo}" class="preview" alt="Photo">
            <div class="title" style="margin-top:0.5rem;">✅ الصورة الشخصية محفوظة</div>
            <div class="hint">اضغط لتغييرها</div>
        `;
    } else {
        photoZone.classList.remove('has-file');
        photoZone.innerHTML = `
            <input type="file" id="photoFile" accept="image/*" onchange="handlePhotoUpload(event, 'photo')">
            <i class="bi bi-person-square big-icon"></i>
            <div class="title">الصورة الشخصية</div>
            <div class="hint">JPG أو PNG - خلفية بيضاء</div>
        `;
    }
    
    // Passport Photo
    const passportZone = document.getElementById('passportZone');
    if (client.passportPhoto) {
        passportZone.classList.add('has-file');
        passportZone.innerHTML = `
            <input type="file" id="passportFile" accept="image/*" onchange="handlePhotoUpload(event, 'passport')">
            <div class="check-badge"><i class="bi bi-check-lg"></i></div>
            <img src="${client.passportPhoto}" class="preview" alt="Passport">
            <div class="title" style="margin-top:0.5rem;">✅ صورة الجواز محفوظة</div>
            <div class="hint">اضغط لتغييرها</div>
        `;
    } else {
        passportZone.classList.remove('has-file');
        passportZone.innerHTML = `
            <input type="file" id="passportFile" accept="image/*" onchange="handlePhotoUpload(event, 'passport')">
            <i class="bi bi-card-text big-icon"></i>
            <div class="title">جواز السفر</div>
            <div class="hint">صفحة البيانات بوضوح</div>
        `;
    }
}

function handlePhotoUpload(event, type) {
    const file = event.target.files[0];
    if (!file) return;
    
    if (!file.type.startsWith('image/')) {
        alert('⚠️ الرجاء اختيار صورة (JPG, PNG)');
        return;
    }
    
    if (file.size > 5 * 1024 * 1024) {
        alert('⚠️ الحجم كبير جداً (الحد 5MB)');
        return;
    }
    
    const reader = new FileReader();
    reader.onload = (e) => {
        const base64 = e.target.result;
        
        if (type === 'photo') {
            state.currentPhotoClient.photo = base64;
            log('SUCCESS', `📸 تم رفع الصورة الشخصية: ${state.currentPhotoClient.name}`);
        } else {
            state.currentPhotoClient.passportPhoto = base64;
            log('SUCCESS', `🛂 تم رفع صورة الجواز: ${state.currentPhotoClient.name}`);
        }
        
        saveState();
        renderPhotoZones(state.currentPhotoClient);
        updateStats();
        renderClients(state.filters.clients);
    };
    reader.readAsDataURL(file);
}

function saveAllPhotos() {
    if (!state.currentPhotoClient) {
        alert('⚠️ اختر زبوناً أولاً');
        return;
    }
    
    const c = state.currentPhotoClient;
    const count = (c.photo ? 1 : 0) + (c.passportPhoto ? 1 : 0);
    
    if (count === 2) {
        log('SUCCESS', `✅ تم حفظ جميع صور ${c.name}`);
        alert(`✅ تم حفظ جميع صور ${c.name}\n\n🎉 الزبون جاهز للحجز!`);
    } else {
        log('WARNING', `⚠️ صور ${c.name}: ${count}/2`);
        alert(`⚠️ ${count}/2 فقط من الصور محفوظة`);
    }
}

function reloadPhotos() {
    if (state.currentPhotoClient) {
        loadClientPhotos();
    }
}

// ===== Captcha =====
function setCaptchaMethod(method, btn) {
    state.captchaMethod = method;
    
    document.querySelectorAll('.method-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    
    const labels = {
        manual: 'يدوي',
        '2captcha': '2Captcha API',
        tesseract: 'Tesseract OCR'
    };
    const hints = {
        manual: 'الطريقة اليدوية هي الأكثر أماناً ودقة للوكالات — موظفك يقرأ الرمز ويدخله',
        '2captcha': 'حل تلقائي عبر خدمة مدفوعة — يتطلب مفتاح API',
        tesseract: 'حل مجاني عبر OCR — الدقة 40-60% فقط'
    };
    
    document.getElementById('currentMethodLabel').textContent = labels[method];
    document.getElementById('methodHint').textContent = hints[method];
    
    saveState();
    log('INFO', `🔐 طريقة الكابتشا: ${labels[method]}`);
}

function resetCaptcha() {
    document.getElementById('captchaDisplay').innerHTML = `
        <div class="no-captcha">
            <i class="bi bi-shield-slash-fill"></i>
            <p><strong>لا توجد كابتشا حالياً</strong></p>
            <p style="font-size:0.85rem;">ارفع صورة الكابتشا من المتصفح لبدء المعالجة</p>
            <label style="display:inline-block; margin-top:1rem; padding:0.75rem 1.5rem; background:var(--primary); color:white; border-radius:10px; cursor:pointer; font-weight:700;">
                <i class="bi bi-upload"></i> رفع صورة الكابتشا
                <input type="file" accept="image/*" style="display:none;" onchange="loadCaptchaImage(event)">
            </label>
        </div>
    `;
    document.getElementById('captchaInput').value = '';
}

function loadCaptchaImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    if (!file.type.startsWith('image/')) {
        alert('⚠️ الرجاء اختيار صورة');
        return;
    }
    
    const reader = new FileReader();
    reader.onload = (e) => {
        document.getElementById('captchaDisplay').innerHTML = `
            <img src="${e.target.result}" alt="Captcha">
            <p style="margin-top:1rem; color:var(--text-sec); font-size:0.85rem;">
                👇 اكتب الرمز الذي تراه في الصورة
            </p>
        `;
        document.getElementById('captchaInput').focus();
        log('INFO', '📸 تم تحميل صورة الكابتشا');
    };
    reader.readAsDataURL(file);
}

function submitCaptcha() {
    const code = document.getElementById('captchaInput').value.trim().toUpperCase();
    
    if (!code) {
        alert('⚠️ أدخل رمز الكابتشا');
        document.getElementById('captchaInput').focus();
        return;
    }
    
    if (code.length < 4) {
        alert('⚠️ الرمز قصير جداً');
        return;
    }
    
    state.stats.captchas++;
    saveState();
    updateStats();
    
    log('SUCCESS', `✅ تم حل الكابتشا: ${code}`);
    
    // Copy to clipboard
    navigator.clipboard.writeText(code).then(() => {
        alert(`✅ تم حل الكابتشا: ${code}\n\n📋 تم نسخها للحافظة\n\nالصقها في المتصفح (Ctrl+V)`);
    }).catch(() => {
        alert(`✅ تم حل الكابتشا: ${code}\n\nالصقها يدوياً في المتصفح`);
    });
    
    document.getElementById('captchaInput').value = '';
}

function saveCaptchaKey() {
    const key = document.getElementById('captchaApiKey').value.trim();
    if (!key) {
        alert('⚠️ أدخل المفتاح');
        return;
    }
    
    state.captchaApiKey = key;
    saveState();
    log('SUCCESS', '🔑 تم حفظ مفتاح 2Captcha');
    alert('✅ تم حفظ المفتاح بنجاح');
}

