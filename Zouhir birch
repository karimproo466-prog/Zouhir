        return;
    }
    
    log('INFO', '📤 جاري إرسال رسالة اختبار...');
    
    fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            chat_id: chatId,
            text: '✅ اختبار ناجح من BLS MANTISX Agency Portal'
        })
    })
    .then(r => r.json())
    .then(data => {
        if (data.ok) {
            log('SUCCESS', '✅ تم إرسال رسالة الاختبار');
