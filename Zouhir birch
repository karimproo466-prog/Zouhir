function cancelBooking(id) {
    const b = state.bookings.find(x => x.id === id);
    if (!b) return;
    if (!confirm(`إلغاء حجز ${b.reference}؟`)) return;
    
    b.status = 'cancelled';
    saveState();
    renderBookings();
    log('WARNING', `🚫 تم إلغاء الحجز: ${b.reference}`);
}

function exportBookings() {
    if (state.bookings.length === 0) {
        alert('لا توجد حجوزات للتصدير');
        return;
    }
    
    const data = JSON.stringify(state.bookings, null, 2);
    downloadFile(data, 'bookings.json', 'application/json');
    log('SUCCESS', 'تم تصدير الحجوزات');
}

