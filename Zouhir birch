// ===== Data Export/Import =====
function exportData() {
    const data = {
        version: '2.0',
        exportedAt: new Date().toISOString(),
        clients: state.clients,
        bookings: state.bookings,
        logs: state.logs,
        settings: state.settings,
        stats: state.stats
    };
    
    const json = JSON.stringify(data, null, 2);
    const filename = `bls_mantisx_backup_${new Date().toISOString().slice(0,10)}.json`;
    downloadFile(json, filename, 'application/json');
    log('SUCCESS', '📦 تم إنشاء نسخة احتياطية');
    alert(`✅ تم إنشاء النسخة الاحتياطية\n\n📁 ${filename}`);
}

function importData() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.json';
    
    input.onchange = (e) => {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = (ev) => {
            try {
                const data = JSON.parse(ev.target.result);
                
                if (!data.clients) {
                    alert('⚠️ ملف غير صالح');
                    return;
                }
                
                if (!confirm(`سيتم استيراد:\n• ${data.clients.length} زبون\n• ${(data.bookings || []).length} حجز\n\nمتابعة؟`)) return;
                
                state.clients = data.clients || [];
                state.bookings = data.bookings || [];
                state.settings = data.settings || state.settings;
                state.stats = data.stats || { captchas: 0 };
                
                saveState();
                updateStats();
                renderClients();
                renderBookings();
                loadSettingsToForm();
                
                log('SUCCESS', `📥 تم استيراد ${state.clients.length} زبون`);
                alert('✅ تم الاستيراد بنجاح');
            } catch (err) {
                alert('❌ خطأ في قراءة الملف: ' + err.message);
            }
        };
        reader.readAsText(file);
    };
    
    input.click();
}

function clearAllData() {
    if (!confirm('⚠️ تحذير!\n\nسيتم حذف جميع البيانات:\n• الزبائن\n• الحجوزات\n• السجلات\n• الإعدادات\n\nلا يمكن التراجع!\n\nمتابعة؟')) return;
    if (!confirm('تأكيد أخير: هل أنت متأكد؟')) return;
    
    localStorage.removeItem('bls_mantisx_v2');
    location.reload();
}

// ===== Helpers =====
function downloadFile(content, filename, type) {
    const blob = new Blob([content], { type: type + ';charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

function loadSettingsToForm() {
    const s = state.settings;
    
    // Agency
    if (s.agency) {
        document.getElementById('setAgencyName').value = s.agency.name || '';
        document.getElementById('setAgencyPhone').value = s.agency.phone || '';
        document.getElementById('setAgencyEmail').value = s.agency.email || '';
        document.getElementById('setAgencyLicense').value = s.agency.license || '';
    }
    
    // Telegram
    if (s.telegram) {
        document.getElementById('setTgToken').value = s.telegram.token || '';
        document.getElementById('setTgChatId').value = s.telegram.chatId || '';
    }
    
    // BLS
    if (s.bls) {
        document.getElementById('setBlsEmail').value = s.bls.email || '';
        document.getElementById('setBlsPassword').value = s.bls.password || '';
    }
    
    // Captcha
    if (state.captchaApiKey) {
        document.getElementById('captchaApiKey').value = state.captchaApiKey;
    }
}

// ===== Save/Load State =====
function saveState() {
    const data = {
        clients: state.clients,
        bookings: state.bookings,
        logs: state.logs,
        settings: state.settings,
        stats: state.stats,
        captchaMethod: state.captchaMethod,
        captchaApiKey: state.captchaApiKey
    };
    
    try {
        localStorage.setItem('bls_mantisx_v2', JSON.stringify(data));
    } catch (e) {
        console.error('Save error:', e);
        if (e.name === 'QuotaExceededError') {
            log('ERROR', '⚠️ الذاكرة ممتلئة! صوّر أكثر من اللازم');
            alert('⚠️ الذاكرة ممتلئة!\n\nاحذف بعض صور الزبائن أو استخدم نسخة احتياطية');
        }
    }
}

function loadState() {
    const saved = localStorage.getItem('bls_mantisx_v2');
    if (!saved) return;
    
    try {
        const data = JSON.parse(saved);
        state.clients = data.clients || [];
        state.bookings = data.bookings || [];
        state.logs = data.logs || [];
        state.settings = data.settings || state.settings;
        state.stats = data.stats || { captchas: 0 };
        state.captchaMethod = data.captchaMethod || 'manual';
        state.captchaApiKey = data.captchaApiKey || '';
    } catch (e) {
        console.error('Load error:', e);
    }
}

// ===== Clock =====
function updateClock() {
    const now = new Date();
    const date = now.toLocaleDateString('ar-EG', { 
        weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' 
    });
    const time = now.toLocaleTimeString('en-GB', { 
        hour: '2-digit', minute: '2-digit' 
    });
    
    document.getElementById('headerDate').textContent = date;
    document.getElementById('headerTime').textContent = time;
}

// ===== Initialization =====
document.addEventListener('DOMContentLoaded', () => {
    loadState();
    updateStats();
    renderClients();
    renderBookings();
    renderLogs();
    loadSettingsToForm();
    updateClock();
    
    setInterval(updateClock, 30000);
    
    log('SYSTEM', '🚀 BLS MANTISX Agency Portal v2.0 started');
    log('INFO', `📊 Loaded: ${state.clients.length} clients, ${state.bookings.length} bookings`);
    
    // Set captcha method
    const methodBtn = document.querySelector(`.method-btn[data-method="${state.captchaMethod}"]`);
    if (methodBtn) setCaptchaMethod(state.captchaMethod, methodBtn);
});

// ===== Keyboard Shortcuts =====
document.addEventListener('keydown', (e) => {
    // Ctrl+R: prevent reload in captcha input
    if (e.ctrlKey && e.key === 'r' && e.target.id === 'captchaInput') {
        e.preventDefault();
    }
    
    // Enter in captcha input → submit
    if (e.key === 'Enter' && e.target.id === 'captchaInput') {
        submitCaptcha();
    }
    
    // ESC: clear captcha
    if (e.key === 'Escape' && e.target.id === 'captchaInput') {
        e.target.value = '';
    }
});

// Prevent accidental navigation away
window.addEventListener('beforeunload', (e) => {
    // Only trigger if there's unsaved work
    const hasData = state.clients.length > 0;
    if (hasData) {
        // Save first
        saveState();
    }
});

