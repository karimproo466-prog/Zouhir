    $('detectCaptchaBtn').addEventListener('click', () => {
        const imgs = document.querySelectorAll('img');
        let found = null;
        
        imgs.forEach(img => {
            const src = (img.src || '').toLowerCase();
            const alt = (img.alt || '').toLowerCase();
            const cls = (img.className || '').toLowerCase();
            const id = (img.id || '').toLowerCase();
            
            if (src.includes('captcha') || src.includes('securimage') || src.includes('captcha') ||
                alt.includes('captcha') || cls.includes('captcha') || id.includes('captcha')) {
                found = img;
            }
        });
        
        if (!found) {
            // البحث عن الصور اللي عندها أبعاد الكابتشا المعتادة
            imgs.forEach(img => {
                const w = img.naturalWidth || img.width;
                const h = img.naturalHeight || img.height;
                if (w > 50 && w < 250 && h > 20 && h < 100 && !found) {
                    found = img;
                }
            });
        }
        
        if (found) {
            try {
                const canvas = document.createElement('canvas');
                canvas.width = found.naturalWidth || found.width;
                canvas.height = found.naturalHeight || found.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(found, 0, 0);
                captchaImage = canvas.toDataURL('image/png');
                renderCaptchaImg(captchaImage);
                toast('✅ تم اكتشاف الكابتشا');
                log('SUCCESS', '🔍 تم اكتشاف صورة الكابتشا');
            } catch(e) {
                captchaImage = found.src;
                renderCaptchaImg(found.src);
                toast('⚠️ تم اكتشاف (بدون تحويل)');
            }
        } else {
            toast('❌ ما لقيناش صورة كابتشا', 'error');
        }
    });
    
