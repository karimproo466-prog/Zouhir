    function saveUser() {
        const name = $('uName').value.trim();
        const email = $('uEmail').value.trim();
        const passport = $('uPassport').value.trim().toUpperCase();
        
        if (!name || !email || !passport) {
            toast('❌ الاسم، البريد، والجواز إلزاميون', 'error');
            return;
        }
        
        const users = UsersStore.get();
        const user = {
            id: 'u_' + Date.now(),
            name, email, passport,
            password: $('uPassword').value,
            dob: $('uDob').value,
            nationality: $('uNationality').value,
            gender: $('uGender').value,
            phone: $('uPhone').value,
            city: $('uCity').value,
            destination: $('uDestination').value,
            visaType: $('uVisaType').value,
            center: $('uCenter').value,
            centerName: 'الناظور',
            createdAt: new Date().toISOString()
        };
        
        users.push(user);
        UsersStore.set(users);
        updateStats();
        clearUserForm();
        renderUsers();
        toast('✅ تم حفظ: ' + name);
        log('SUCCESS', `👤 زبون جديد: ${name} - ${passport}`);
    }
    
    function clearUserForm() {
        ['uName','uEmail','uPassword','uPassport','uDob','uPhone','uCity'].forEach(id => $(id).value = '');
        $('uNationality').value = 'Morocco';
        $('uGender').value = 'M';
        $('uDestination').value = 'Spain';
        $('uVisaType').value = 'Tourism';
        $('uCenter').value = '8';
        $('uCity').value = 'الناظور';
    }
    
    function renderUsers() {
        const users = UsersStore.get();
        const container = $('usersList');
        $('usersCount').textContent = users.length;
        
        if (users.length === 0) {
            container.innerHTML = `
                <div class="bls-empty">
                    <div class="icon">📭</div>
                    <p>لا يوجد زبائن مسجلين</p>
                    <p style="font-size:0.8rem;">سجل زبون جديد من فوق</p>
                </div>
            `;
            return;
        }
        
        container.innerHTML = users.map(u => `
            <div class="bls-card">
                <div class="info">
                    <h4>👤 ${u.name}</h4>
                    <p>🪪 ${u.passport} | ✉️ ${u.email}</p>
                    <p>✈️ ${u.destination || 'Spain'} - 📍 ${u.centerName || 'الناظور'}</p>
                </div>
                <div class="btns">
                    <button class="icon-btn green" data-action="fill" data-id="${u.id}" title="تعبئة">🎯</button>
                    <button class="icon-btn blue" data-action="edit" data-id="${u.id}" title="عرض">👁️</button>
                    <button class="icon-btn red" data-action="delete" data-id="${u.id}" title="حذف">🗑️</button>
                </div>
            </div>
        `).join('');
        
        container.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const action = btn.dataset.action;
                if (action === 'fill') fillForm(id);
                if (action === 'edit') viewUser(id);
                if (action === 'delete') deleteUser(id);
            });
        });
    }
    
    function deleteUser(id) {
        if (!confirm('حذف هذا الزبون؟')) return;
        UsersStore.set(UsersStore.get().filter(u => u.id !== id));
        renderUsers();
        updateStats();
        toast('🗑️ تم الحذف', 'info');
    }
    
    function viewUser(id) {
        const u = UsersStore.get().find(x => x.id === id);
        if (!u) return;
        alert(`📋 بيانات الزبون
━━━━━━━━━━━━━━━━━━
👤 الاسم: ${u.name}
🪪 الجواز: ${u.passport}
✉️ البريد: ${u.email}
📱 الهاتف: ${u.phone || '--'}
📅 الميلاد: ${u.dob || '--'}
📍 المركز: ${u.centerName || 'الناظور'}
✈️ الوجهة: ${u.destination}
🎫 التأشيرة: ${u.visaType}`);
    }
    
    function fillForm(id) {
        const user = UsersStore.get().find(u => u.id === id);
        if (!user) return;
        
        toast('🎯 جاري تعبئة الخانات...', 'info');
        
        let filled = 0;
        const setVal = (el, val) => {
            if (!el || !val) return false;
            el.focus();
            el.value = val;
            el.dispatchEvent(new Event('input', {bubbles: true}));
            el.dispatchEvent(new Event('change', {bubbles: true}));
            el.dispatchEvent(new Event('blur', {bubbles: true}));
            return true;
        };
        
        const inputs = document.querySelectorAll('input:not([type=hidden]):not([type=file]):not([type=submit]), select');
        
        inputs.forEach(input => {
            if (input.offsetParent === null) return;
            
            const label = (input.name || input.id || input.placeholder || input.getAttribute('aria-label') || '').toLowerCase();
            const type = (input.type || '').toLowerCase();
            const tag = input.tagName.toLowerCase();
            
            // Email
            if (type === 'email' || label.match(/e[-_]?mail|email/)) {
                if (setVal(input, user.email)) filled++;
            }
            // Password
            else if (type === 'password' || label.match(/pass/)) {
                if (user.password && setVal(input, user.password)) filled++;
            }
            // Phone
            else if (type === 'tel' || label.match(/phone|mobile|tel|gsm/)) {
                if (setVal(input, user.phone)) filled++;
            }
            // Passport
            else if (label.match(/passport|pass_num|passportno|passno/)) {
                if (setVal(input, user.passport)) filled++;
            }
            // Date of birth
            else if (type === 'date' && label.match(/birth|dob|bday/)) {
                if (setVal(input, user.dob)) filled++;
            }
            // Surname
            else if (label.match(/surname|family|last.?name/)) {
                const parts = user.name.split(' ');
                if (setVal(input, parts[parts.length - 1])) filled++;
            }
            // First name
            else if (label.match(/first.?name|given|prenom/)) {
                const parts = user.name.split(' ');
                if (setVal(input, parts[0])) filled++;
            }
            // Full name
            else if (label.match(/full.?name|nom|name/) && !label.match(/user|file|center|city/)) {
                if (setVal(input, user.name)) filled++;
            }
            // City
            else if (label.match(/city|ville|place.?birth/)) {
                if (setVal(input, user.city)) filled++;
            }
            // Select for country/nationality
            else if (tag === 'select' && label.match(/nation|country|pays/)) {
                setVal(input, user.nationality);
                filled++;
            }
        });
        
        if (filled > 0) {
            toast(`✅ تم تعبئة ${filled} خانة`, 'success');
            log('SUCCESS', `🎯 تعبئة الزبون: ${user.name} - ${filled} خانة`);
