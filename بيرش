    function fillCaptchaInPage(code) {
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            if (input.offsetParent === null) return;
            const label = (input.name || input.id || input.placeholder || '').toLowerCase();
            const maxlen = parseInt(input.maxLength || 0);
            
            if (label.includes('captcha') || label.includes('code') || (maxlen > 3 && maxlen < 10 && input.type === 'text')) {
                input.focus();
                input.value = code;
                input.dispatchEvent(new Event('input', {bubbles: true}));
                input.dispatchEvent(new Event('change', {bubbles: true}));
            }
        });
    }
    
    $('solveCaptchaBtn').addEventListener('click', async () => {
        if (!captchaImage) { toast('⚠️ ارفع صورة الكابتشا أولاً', 'warning'); return; }
        const config = CaptchaStore.get();
        if (!config.apiKey) { toast('❌ أدخل مفتاح 2Captcha', 'error'); return; }
        
        toast('🤖 جاري حل الكابتشا...', 'info');
        log('INFO', '🤖 إرسال الكابتشا لـ 2Captcha...');
        
        try {
            const base64 = captchaImage.split(',')[1];
            
            const submit = await new Promise((resolve, reject) => {
                GM_xmlhttpRequest({
                    method: 'POST',
                    url: 'https://2captcha.com/in.php',
                    data: `method=base64&key=${config.apiKey}&body=${encodeURIComponent(base64)}&json=1`,
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    onload: (res) => resolve(JSON.parse(res.responseText)),
                    onerror: reject
                });
            });
            
            if (submit.status !== 1) throw new Error(submit.request || 'فشل');
            
            const captchaId = submit.request;
            toast('⏳ انتظار الحل... (10-30 ثانية)', 'info');
            
            for (let i = 0; i < 30; i++) {
                await new Promise(r => setTimeout(r, 3000));
                
                const result = await new Promise((resolve, reject) => {
                    GM_xmlhttpRequest({
                        method: 'GET',
                        url: `https://2captcha.com/res.php?key=${config.apiKey}&action=get&id=${captchaId}&json=1`,
                        onload: (res) => resolve(JSON.parse(res.responseText)),
                        onerror: reject
                    });
                });
                
                if (result.status === 1) {
                    const code = result.request.toUpperCase();
                    $('captchaInput').value = code;
                    await copyToClipboard(code);
                    toast('✅ الحل: ' + code);
                    log('SUCCESS', `🤖 2Captcha حل: ${code}`);
                    fillCaptchaInPage(code);
                    
                    const stats = StatsStore.get();
                    stats.captchasSolved = (stats.captchasSolved || 0) + 1;
                    StatsStore.set(stats);
                    updateStats();
                    return;
                }
                
                if (result.request !== 'CAPCHA_NOT_READY') {
                    throw new Error(result.request);
                }
            }
            throw new Error('انتهت المهلة');
        } catch(err) {
            toast('❌ ' + err.message, 'error', 5000);
            log('ERROR', `❌ فشل حل الكابتشا: ${err.message}`);
        }
    });
    
    function copyToClipboard(text) {
        return new Promise((resolve) => {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(resolve).catch(() => {
                    fallbackCopy(text);
                    resolve();
                });
            } else {
                fallbackCopy(text);
                resolve();
            }
        });
    }
    
    function fallbackCopy(text) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e) {}
        ta.remove();
    }
    
