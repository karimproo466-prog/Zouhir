        if (!confirm('⚠️ حذف كل البيانات؟')) return;
        if (!confirm('تأكيد نهائي؟')) return;
        UsersStore.set([]);
        ProxiesStore.set([]);
        CaptchaStore.set({ apiKey: '' });
        SettingsStore.set({ autoFill: true, autoCaptcha: false });
        LogsStore.set([]);
        StatsStore.set({ checks: 0, slotsFound: 0, captchasSolved: 0, startTime: Date.now() });
        renderUsers();
        renderProxies();
        renderLogs();
        updateStats();
        loadSettings();
        loadCaptchaApiKey();
        toast('🗑️ تم مسح كل شيء', 'warning');
    });

    // ═══════════════════════════════════════════
    // 📊 STATS
    // ═══════════════════════════════════════════
    function updateStats() {
        const users = UsersStore.get();
        const stats = StatsStore.get();
        const proxies = ProxiesStore.get();
        
        $('fabBadge').textContent = users.length;
        $('usersCount').textContent = users.length;
        $('captchaSolvedCount').textContent = stats.captchasSolved || 0;
        $('captchaTotalCount').textContent = stats.captchasSolved || 0;
        
        $('pTotal').textContent = proxies.length;
        $('pWorking').textContent = proxies.filter(p => p.status === 'working').length;
        $('pFailed').textContent = proxies.filter(p => p.status === 'failed').length;
        $('pUntested').textContent = proxies.filter(p => p.status === 'untested').length;
    }

    // ═══════════════════════════════════════════
    // 🛠️ Helpers
    // ═══════════════════════════════════════════
    function dateStr() {
        return new Date().toISOString().slice(0, 10);
    }
    
    function download(content, filename, type = 'application/json') {
        const blob = new Blob([content], { type: type + ';charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        a.click();
        URL.revokeObjectURL(a.href);
    }

    // ═══════════════════════════════════════════
    // 🚀 INIT
    // ═══════════════════════════════════════════
    updateStats();
    log('SYSTEM', '🚀 BLS MANTISX v3.0 - الناظور');
    log('INFO', '🇲🇦 مركز: الناظور (ID: 8)');
    log('INFO', '📅 المواعيد: كل سبت على الساعة 10:00');
    
    console.log('%c🇲🇦 BLS MANTISX - الناظور v3.0', 
        'background:linear-gradient(135deg,#c1272d,#006233); color:white; padding:10px 20px; font-weight:bold; border-radius:5px; font-size:14px;');
    console.log('%c✅ جاهز للعمل', 'color:#10b981; font-weight:bold; font-size:12px;');

})();
