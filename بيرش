    async function testProxy(id) {
        const proxies = ProxiesStore.get();
        const proxy = proxies.find(p => p.id === id);
        if (!proxy) return;
        
        proxy.status = 'testing';
        ProxiesStore.set(proxies);
        renderProxies();
        
        const startTime = Date.now();
        
        // ملاحظة: الاختبار الحقيقي يحتاج Backend أو Selenium
        // هنا كنديرو محاكاة
        
        setTimeout(() => {
            const time = Date.now() - startTime;
            const updated = ProxiesStore.get();
            const p = updated.find(x => x.id === id);
            if (p) {
                // محاكاة - في الواقع خاصنا اختبار حقيقي
                p.status = Math.random() > 0.3 ? 'working' : 'failed';
                p.responseTime = p.status === 'working' ? Math.floor(Math.random() * 500) + 80 : null;
                p.lastTest = new Date().toISOString();
                ProxiesStore.set(updated);
                renderProxies();
                updateStats();
                
                toast(p.status === 'working' ? `✅ ${proxy.host} يعمل` : `❌ ${proxy.host} فاشل`,
                      p.status === 'working' ? 'success' : 'error');
                log(p.status === 'working' ? 'SUCCESS' : 'ERROR', 
                    `🌐 ${proxy.host}:${proxy.port} ${p.status === 'working' ? '✅' : '❌'}`);
            }
        }, 1200);
    }
    
